---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLang, type Lang } from '../i18n/ui';
import { contact } from '../data/contact';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Aynı sayfanın diğer dildeki yolu (ör. "/en/about/"). Verilirse hreflang etiketleri üretilir. */
  alternate?: string;
  ogType?: 'website' | 'article';
  /** İç sayfalarda içeriğin üstünde gösterilen "geri" bağlantısı (üst sayfaya götürür). */
  back?: { href: string; label: string };
}

const {
  title,
  description,
  lang = defaultLang,
  alternate,
  ogType = 'website',
  back,
} = Astro.props;

const siteName = 'İscotera';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternateUrl = alternate ? new URL(alternate, Astro.site) : undefined;
const otherLang: Lang = lang === 'tr' ? 'en' : 'tr';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: Astro.site?.toString(),
  logo: new URL('/favicon.svg', Astro.site).toString(),
  email: contact.email,
  telephone: contact.phoneE164,
  // TODO: LinkedIn / GitHub profilleri açılınca buraya eklenecek
  sameAs: [contact.instagramUrl],
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    {/* Mobil tarayıcı çubuğunun rengi. Değeri aşağıdaki script belirler:
        prefers-color-scheme'e bağlanamaz, çünkü kullanıcı sistem tercihinin
        tersini seçebiliyor — o zaman çubuk sayfayla uyuşmaz kalırdı. Buradaki
        değer JavaScript kapalıyken geçerli olan açık mod karşılığıdır. */}
    <meta name="theme-color" content="#ffffff" />

    {/* Tema tercihi sayfa boyanmadan ÖNCE yazılmalı; aksi halde karanlık modda
        her sayfa geçişinde bir kare beyaz ekran görünür. Bu yüzden is:inline:
        Astro bu script'i paketlemez, olduğu gibi ve senkron çalıştırır. */}
    <script is:inline>
      // Header'daki tema düğmesi de bu fonksiyonu çağırır; renk değerleri
      // tek yerde dursun diye global tanımlandı.
      window.__setTheme = function (theme) {
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = theme === 'dark' ? '#101012' : '#ffffff';
        // Anahtarların görünümünü CSS hallediyor; ekran okuyucunun duyduğu
        // açık/kapalı durumu ise burada güncellenir. Bu script <head>'de
        // çalıştığında düğmeler henüz yok — Header yüklenince tekrar çağırır.
        document.querySelectorAll('[data-theme-toggle]').forEach(function (el) {
          el.setAttribute('aria-checked', theme === 'dark' ? 'true' : 'false');
        });
      };

      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark =
            stored === 'dark' ||
            (stored === null &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          window.__setTheme(dark ? 'dark' : 'light');
        } catch (e) {
          // Gizli sekmede localStorage erişimi hata verebilir; açık mod varsayılan.
          window.__setTheme('light');
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      alternateUrl && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={otherLang} href={alternateUrl} />
          <link
            rel="alternate"
            hreflang="x-default"
            href={lang === defaultLang ? canonical : alternateUrl}
          />
        </>
      )
    }

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    {/* TODO: og:image — sosyal paylaşım görseli hazırlanınca eklenecek */}
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    {/* Sayfaya özel yapılandırılmış veri buraya girer (ör. ürün sayfasının
        SoftwareApplication ve FAQPage şemaları). */}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-ink antialiased">
    <Header lang={lang} alternate={alternate} />
    <main class="flex-1">
      {
        back && (
          <div class="mx-auto w-full max-w-5xl px-4 pt-6">
            <a
              href={back.href}
              class="inline-flex min-h-11 items-center gap-1.5 text-sm text-ink-subtle transition-colors hover:text-ink-strong"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 18 L9 12 L15 6" />
              </svg>
              {back.label}
            </a>
          </div>
        )
      }
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
