---
// Ürün vitrini paneli: ana sayfada ve ürün listesinde her ürün kendi renginde
// büyük bir panel olarak durur. Ürünler tuvalinde seçilen "H — Ürün renginde
// panel" (2026-09-23): solda beyaz yazılar ve beyaz hap buton, sağda ürünün
// görselleri panelin kenarından taşar. Yerini aldığı tam genişlik şerit
// tıklanabilir görünmüyordu; burada bütün panel tek bir bağlantıdır.
//
// Zemin ürünün kendi rengidir (frontmatter'daki `color`) ve açık/koyu modda
// değişmez. Bu yüzden paneldeki beyaz yazı, beyaz buton ve yeşil durum noktası
// token değil sabit renk: token'lar modla birlikte değişir, bu zemin değişmez.
// Rengin beyaz yazıyla kontrastı içerik şemasında denetlenir.
//
// Görsel: dikey kapak (telefon ekranı) telefon olarak durur; geniş ekranda
// arkasına ürünün ilk dikey özellik görseli ikinci telefon olarak eklenir.
// Yatay kapak (masaüstü ekranı) sağ kenardan taşar. Görseller
// productImageOptions ile üretilir; ürün sayfası aynı dosyaları kullandığı
// için tarayıcı ikinci bir kopya indirmez.
//
// Dar ekran (md altı): panel bir telefon ekranını dolduruyordu (2026-09-28,
// kullanıcının şikâyeti). Artık yazı ölçüleri bir kademe küçük ve görsel
// ayrı bir bant yerine son satırı butonla paylaşır: telefon, buton satırının
// sağından panelin alt kenarından taşarak "göz atar". Yatay kapak ise butonun
// altında kısa bir bant olarak sağ-alt köşeden taşar (yatay bir görselin
// köşede yeri yoktur). Ekran görüntüsü üstten kırpılır ki başlık okunsun,
// fotoğraf ortadan ki konu (ör. QR kartı) görünsün.
//
// Bunun için yazı sütunu dar ekranda `contents`: çocukları doğrudan panelin
// iki sütunlu ızgarasına girer; yalnızca sonuç+buton bloğu ilk sütunda kalır,
// telefon ikinci sütunda aynı satıra oturur. md'den itibaren yazı sütunu
// eskisi gibi tek bir dikey flex sütunudur ve panel iki sütunlu ızgaradır.

import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Rating from './Rating.astro';
import {
  isLandscape,
  isScreenshot,
  platformLabels,
  productImageOptions,
} from '../utils/product';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  href: string;
  /** Buton metni (ör. "Ürünü incele"). */
  linkLabel: string;
  lang: Lang;
  /** Başlık seviyesi: listede h2, ana sayfada bölüm başlığının altında h3. */
  as?: 'h2' | 'h3';
  /** Sayfanın ilk ekranındaki panel: görseli ertelenmeden yüklenir (LCP adayı). */
  eager?: boolean;
}

const {
  project,
  href,
  linkLabel,
  lang,
  as: Heading = 'h3',
  eager = false,
} = Astro.props;
const { title, description, tagline, status, category, rating, cover, results, features, color } =
  project.data;

const t = useTranslations(lang);
const statusLabel = t(`product.status.${status}`);
const metaLine = [category, ...platformLabels(project.data)].filter(Boolean).join(' · ');

// Renk yazılmamışsa nötr koyu gri (neutral-800): beyaz yazıyla 15:1.
const background = color ?? '#262626';

const wide = cover ? isLandscape(cover) : false;
// Arkadaki ikinci telefon yalnızca kapak da dikeyse anlamlı.
const backShot =
  cover && !wide
    ? features.map((feature) => feature.image).find((image) => image && !isLandscape(image))
    : undefined;

const imageLoading = eager ? 'eager' : 'lazy';
const imagePriority = eager ? 'high' : undefined;

// Görseller üzerine gelince hafifçe yükselir; hareket azaltma tercihinde durur.
const lift =
  'motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:-translate-y-2.5';
const shadow = 'shadow-[0_30px_60px_-20px_rgba(0,0,0,0.6)]';
---

<a
  href={href}
  class="group relative grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 overflow-hidden rounded-3xl p-6 text-white hover:shadow-2xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-action-ink sm:p-10 md:min-h-[440px] md:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] md:gap-0 md:p-0 motion-safe:transition motion-safe:duration-200 motion-safe:hover:-translate-y-1"
  style={`background-color: ${background}`}
>
  <div class="contents md:relative md:z-10 md:flex md:flex-col md:py-[52px] md:pr-6 md:pl-[52px]">
    <div class="col-span-2 flex flex-wrap items-center gap-3">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-white/30 px-3 py-1 text-xs font-bold"
      >
        <span
          class:list={[
            'h-1.5 w-1.5 rounded-full',
            status === 'live' ? 'bg-green-400' : 'bg-white/50',
          ]}
          aria-hidden="true"
        ></span>
        {statusLabel}
      </span>
      {metaLine && <span class="text-sm text-white/80">{metaLine}</span>}
    </div>

    <Heading
      class="col-span-2 mt-4 text-[26px] leading-[1.1] font-bold sm:text-4xl md:mt-5 lg:text-[44px]"
    >
      {title}
    </Heading>

    <p class="col-span-2 mt-3 max-w-md text-base leading-relaxed text-white/85 md:mt-4 md:text-lg">
      {tagline ?? description}
    </p>

    {
      rating && (
        <Rating
          value={rating.value}
          count={rating.count}
          lang={lang}
          tone="inverse"
          class="col-span-2 mt-4 md:mt-5"
        />
      )
    }

    {/* Sonuçlar ve buton birlikte panelin dibine iner: geniş ekranda mt-auto
        ile (içerik uzarsa üstünde yine en az 32px boşluk kalır), dar ekranda
        telefonun yanındaki son satırın dibine. self-end yalnızca ızgarada:
        flex sütununda yatay eksene işler ve bloğu sağa yaslardı. */}
    <div class="col-start-1 mt-5 self-end md:mt-auto md:self-stretch md:pt-8">
      {
        results.length > 0 && (
          <dl class="mb-5 flex flex-wrap gap-x-8 gap-y-3 md:mb-8">
            {results.map((result) => (
              <div class="flex items-baseline gap-2">
                <dt class="text-2xl leading-8 font-bold md:text-[28px]">{result.value}</dt>
                <dd class="text-sm text-white/80">{result.label}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <span
        class="inline-flex min-h-12 items-center gap-2.5 rounded-full bg-white px-6 text-[15px] font-semibold whitespace-nowrap text-neutral-900 transition-colors group-hover:bg-neutral-200 group-focus-visible:bg-neutral-200"
      >
        {linkLabel}
        <svg
          viewBox="0 0 24 24"
          class="h-[18px] w-[18px] motion-safe:transition-transform motion-safe:group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m13 6 6 6-6 6"></path>
        </svg>
      </span>
    </div>
  </div>

  {
    cover &&
      (wide ? (
        <div
          class="relative col-span-2 -mx-6 -mb-6 mt-5 h-40 sm:-mx-10 sm:-mb-10 md:col-auto md:m-0 md:h-auto"
        >
          <Image
            src={cover}
            alt=""
            {...productImageOptions(cover)}
            loading={imageLoading}
            fetchpriority={imagePriority}
            class:list={[
              'absolute top-4 left-6 h-full w-full rounded-tl-2xl object-cover sm:left-10 md:top-[72px] md:left-2 md:h-auto md:w-[640px] md:max-w-none md:rounded-2xl',
              isScreenshot(cover) ? 'object-top' : 'object-center',
              shadow,
              lift,
            ]}
          />
        </div>
      ) : (
        <div
          class="relative col-start-2 min-h-36 w-28 sm:min-h-44 sm:w-40 md:col-auto md:min-h-0 md:w-auto"
        >
          {backShot && (
            <Image
              src={backShot}
              alt=""
              {...productImageOptions(backShot)}
              loading={imageLoading}
              class:list={[
                'absolute top-24 right-[250px] hidden h-[440px] w-[220px] max-w-none rounded-[22px] object-cover object-top lg:block',
                shadow,
                lift,
              ]}
            />
          )}
          <Image
            src={cover}
            alt=""
            {...productImageOptions(cover)}
            loading={imageLoading}
            fetchpriority={imagePriority}
            class:list={[
              'absolute top-0 right-0 h-56 w-28 max-w-none rounded-[18px] object-cover object-top sm:h-80 sm:w-40 md:top-12 md:right-14 md:h-[480px] md:w-60 md:rounded-[22px]',
              shadow,
              lift,
            ]}
          />
        </div>
      ))
  }
</a>
