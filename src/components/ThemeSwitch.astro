---
// Açık/koyu tema anahtarı. Header'da iki kez kullanılır: masaüstü menüsünde ve
// mobilde hamburger'ın yanında. Durumu <html data-theme> belirler; topuzun yeri
// ve ikonların vurgusu CSS'ten gelir, böylece sayfa ilk boyandığında doğru
// görünür — JavaScript'in çalışmasını beklemez.
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Kapsayıcıya eklenecek yerleşim sınıfları (ör. "md:hidden"). */
  class?: string;
}

const { lang, class: className } = Astro.props;

// role="switch" olduğu için etiket eylemi değil, açılıp kapanan şeyi söyler:
// ekran okuyucu "Koyu tema, açık/kapalı" diye okur.
const label = lang === 'tr' ? 'Koyu tema' : 'Dark theme';
---

<button
  type="button"
  role="switch"
  aria-checked="false"
  data-theme-toggle
  aria-label={label}
  class:list={[
    'relative inline-flex h-8 w-16 shrink-0 items-center rounded-full border border-line-strong bg-surface-raised',
    // Görsel yükseklik 32px. Dokunma alanını 48px'e çıkaran görünmez katman —
    // anahtarın kendisini büyütmeden parmakla rahat basılır hale getirir.
    "before:absolute before:-inset-2 before:content-['']",
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-action-ink',
    className,
  ]}
>
  {/* Kayan topuz. Yükselti karanlıkta ters çevrilmek zorunda: açık modda beyaz
      topuz gri rayın üstünde yükselir, koyu modda ray topuzdan daha koyudur. */}
  <span
    class="absolute left-1 h-6 w-6 rounded-full bg-surface shadow-sm transition-transform duration-200 motion-reduce:transition-none dark:translate-x-[30px] dark:bg-line-strong dark:shadow-none"
  ></span>

  {/* İki ikon da hep görünür; hangisinin vurgulu olduğu modu anlatır. */}
  <span class="relative z-10 flex flex-1 justify-center text-ink-strong dark:text-ink-faint">
    <svg
      viewBox="0 0 24 24"
      class="h-4 w-4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      ></path>
    </svg>
  </span>
  <span class="relative z-10 flex flex-1 justify-center text-ink-faint dark:text-ink-strong">
    <svg
      viewBox="0 0 24 24"
      class="h-4 w-4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
  </span>
</button>
