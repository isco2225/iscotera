---
// Mağaza puanı.
//
// Puan hiçbir zaman tek başına gösterilmiyor, hep değerlendirme sayısıyla
// birlikte: "5,0" kaç kişiye dayandığını söylemediği sürece güven sinyali
// değil, süs. Aynı sebeple bu bileşen sayfada görünmeden puan yapılandırılmış
// veriye de yazılmıyor (bkz. ProductPage.astro).
//
// Yıldızlar dekoratif, o yüzden marka kırmızısını kullanabiliyorlar; okunacak
// bilgi yanlarındaki metinde. Ekran okuyucu yıldızları hiç duymuyor, tek bir
// tam cümle duyuyor.
//
// tone="inverse": ürün vitrini paneli gibi modla değişmeyen koyu bir zeminde
// yıldızlar ve metin beyaz tonlarına geçer.

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  value: number;
  count: number;
  lang: Lang;
  tone?: 'default' | 'inverse';
  class?: string;
}

const { value, count, lang, tone = 'default', class: className } = Astro.props;
const inverse = tone === 'inverse';

const t = useTranslations(lang);
const locale = lang === 'tr' ? 'tr-TR' : 'en-US';

// Türkçede ondalık ayracı virgül: "5,0". İngilizcede "5.0".
const valueText = new Intl.NumberFormat(locale, {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
}).format(value);
const countText = new Intl.NumberFormat(locale).format(count);
const unit = count === 1 ? t('product.ratingUnit') : t('product.ratingUnitPlural');

const ariaLabel = t('product.ratingAria')
  .replace('{value}', valueText)
  .replace('{count}', countText);

// Kesirli puan: gri yıldız sırasının üstüne, oranı kadar kırpılmış kırmızı
// sıra bindiriliyor.
const fillPercent = (Math.max(0, Math.min(5, value)) / 5) * 100;
const STAR =
  'M12 2.6l2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.45l-5.81 3.05 1.11-6.47-4.7-4.58 6.5-.95L12 2.6z';
const stars = [0, 1, 2, 3, 4];
---

<div class:list={['flex items-center gap-2', className]} role="img" aria-label={ariaLabel}>
  <div class="relative inline-flex" aria-hidden="true">
    <div class:list={['flex', inverse ? 'text-white/30' : 'text-line-strong']}>
      {
        stars.map(() => (
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="currentColor">
            <path d={STAR} />
          </svg>
        ))
      }
    </div>
    <div
      class:list={[
        'absolute inset-y-0 left-0 flex overflow-hidden',
        inverse ? 'text-white' : 'text-brand',
      ]}
      style={`width: ${fillPercent}%`}
    >
      {
        stars.map(() => (
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="currentColor">
            <path d={STAR} />
          </svg>
        ))
      }
    </div>
  </div>
  <span class:list={['text-sm', inverse ? 'text-white/80' : 'text-ink-muted']}>
    {valueText} &middot; {countText} {unit}
  </span>
</div>
