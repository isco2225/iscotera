---
// İletişim sayfalarındaki kanal kartı (e-posta, telefon, WhatsApp, Instagram).

interface Props {
  href: string;
  label: string;
  value: string;
  icon: 'mail' | 'phone' | 'whatsapp' | 'instagram';
  /** Dış bağlantılar yeni sekmede açılır. */
  external?: boolean;
}

const { href, label, value, icon, external = false } = Astro.props;
---

<a
  href={href}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
  class="group flex items-start gap-4 rounded-lg border border-line p-6 transition hover:border-brand/40 hover:shadow-md"
>
  <svg
    viewBox="0 0 24 24"
    class="h-6 w-6 shrink-0 text-ink-faint transition-colors group-hover:text-brand"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {
      icon === 'mail' && (
        <>
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </>
      )
    }
    {
      icon === 'phone' && (
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
      )
    }
    {
      icon === 'whatsapp' && (
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
      )
    }
    {
      icon === 'instagram' && (
        <>
          <rect x="2" y="2" width="20" height="20" rx="5" />
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
        </>
      )
    }
  </svg>
  <div class="min-w-0">
    <div class="font-semibold text-ink-strong">{label}</div>
    <div class="mt-1 truncate text-sm text-ink-muted">{value}</div>
  </div>
</a>
