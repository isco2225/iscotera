---
// Ürün vitrini şeridi: hem ürün listesinde hem ana sayfada kullanılır.
// Tuvalde onaylanan "Yön 1 — Vitrin Şeridi" (2026-08-29): kutulu kart yerine
// hizmetler sayfasıyla aynı dil — soluk zeminli tam genişlik bant, solda
// anlatı + iri istatistik, sağda gölgeli ekran görüntüsü. Birden fazla ürün
// olduğunda şeritler zemin ve görsel yönünü dönüşümlü değiştirir.
//
// Bilgi sırası kartlı sürümden miras: önce ne olduğu (logo + başlık), sonra
// güvenilir mi (durum + tür/platform), sonra vaadi (slogan), sonra sonuçlar.
// Durum rozetindeki kırmızı nokta logodaki noktayla aynı marka dilidir.

import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Rating from './Rating.astro';
import { isLandscape, platformLabels, productImageOptions } from '../utils/product';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  href: string;
  /** Bağlantı metni (ör. "Ürünü incele"). */
  linkLabel: string;
  lang: Lang;
  /** Başlık seviyesi: listede h2, ana sayfada bölüm başlığının altında h3. */
  as?: 'h2' | 'h3';
  /** Sıra numarası: şerit zeminini ve görselin yönünü belirler. */
  index?: number;
}

const {
  project,
  href,
  linkLabel,
  lang,
  as: Heading = 'h3',
  index = 0,
} = Astro.props;
const { title, description, tagline, status, category, rating, logo, cover, results } =
  project.data;

const t = useTranslations(lang);
const statusLabel = t(`product.status.${status}`);
const metaLine = [category, ...platformLabels(project.data)]
  .filter(Boolean)
  .join(' · ');

const muted = index % 2 === 0;
const reverse = index % 2 === 1;
// Telefon ekranı dar sütunda dikey kırpılır; yatay bir masaüstü görüntüsü
// kırpılmadan sığsın diye sütunlar eşitlenir ve yükseklik serbest kalır.
const wide = cover ? isLandscape(cover) : false;
---

<a
  href={href}
  class:list={[
    'group block',
    muted && 'border-y border-line bg-surface-muted',
  ]}
>
  <div
    class:list={[
      'mx-auto grid max-w-5xl items-center gap-10 px-4 py-12 md:gap-16 md:py-14',
      wide ? 'md:grid-cols-2' : 'md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]',
    ]}
  >
    <div class:list={[reverse && 'md:order-2']}>
      <div class="flex items-center gap-4">
        {
          logo && (
            <Image
              src={logo}
              alt=""
              width={104}
              class="h-12 w-12 shrink-0 rounded-xl border border-line"
            />
          )
        }
        <Heading
          class="text-3xl font-bold text-ink-strong transition-colors group-hover:text-action-ink"
        >
          {title}
        </Heading>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-line-strong px-3 py-1 text-xs font-bold text-ink-strong"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true"
          ></span>
          {statusLabel}
        </span>
        <span class="text-sm text-ink-subtle">{metaLine}</span>
      </div>

      <p class="mt-5 max-w-md text-xl leading-relaxed text-ink-soft">
        {tagline ?? description}
      </p>

      {
        rating && (
          <Rating value={rating.value} count={rating.count} lang={lang} class="mt-4" />
        )
      }

      {
        results.length > 0 && (
          <dl class="mt-6 flex flex-wrap items-baseline gap-x-10 gap-y-3 border-t border-line pt-5">
            {results.map((result) => (
              <div class="flex items-baseline gap-2">
                <dt class="text-3xl font-bold text-ink-strong">{result.value}</dt>
                <dd class="text-sm text-ink-subtle">{result.label}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <span
        class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-action-ink"
      >
        {linkLabel}
        <span
          class="inline-block transition-transform group-hover:translate-x-1"
          aria-hidden="true">&rarr;</span
        >
      </span>
    </div>

    {
      cover && (
        <Image
          src={cover}
          alt=""
          {...productImageOptions(cover)}
          class:list={[
            'w-full rounded-2xl shadow-xl',
            wide
              ? 'border border-line'
              : 'h-96 max-w-[340px] justify-self-center object-cover object-top sm:h-[26rem]',
            reverse && 'md:order-1',
          ]}
        />
      )
    }
  </div>
</a>
