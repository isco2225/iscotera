---
// Ürün detay sayfasının tamamı.
//
// TR ve EN rotaları (src/pages/urunler/[slug].astro ve
// src/pages/en/products/[slug].astro) bu bileşeni çağırıyor. Sitenin geri
// kalanında sayfalar dil başına ayrı yazılıyor ama burada bilerek tek gövde
// var: bölüm sırası satış akışının kendisi, iki dilde ayrışırsa bir taraf
// sessizce eksik kalır. Değişen her şey (metinler) zaten ui.ts'te.
//
// Bölüm sırası: hero → kanıt → özellikler → ekranlar → anlatı → yorumlar →
// fiyat → SSS → kapanış. Boş bırakılan alanın bölümü hiç render edilmiyor.

import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductMeta from './ProductMeta.astro';
import Rating from './Rating.astro';
import StoreBadges from './StoreBadges.astro';
import FeatureRow from './FeatureRow.astro';
import Faq from './Faq.astro';
import SocialLinks from './SocialLinks.astro';
import {
  isLandscape,
  isPlaceholder,
  platformLabels,
  productImageOptions,
  warnUnfinishedData,
} from '../utils/product';
import { routes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  alternate?: string;
}

const { project, lang, alternate } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(project);

const {
  title,
  description,
  tagline,
  status,
  category,
  logo,
  cover,
  video,
  stores,
  rating,
  results,
  features,
  testimonials,
  pricing,
  faq,
  social,
  links,
  app,
} = project.data;

const platforms = platformLabels(project.data);
warnUnfinishedData(title, project.data);

// tagline hero'daki kısa vaat cümlesi, description ise arama sonucunda
// görünen tam açıklama. İkisi ayrı: tagline'ı meta description olarak
// kullanmak arama sonucundaki satırı gereksiz yere kısaltıyordu.
const promise = tagline ?? description;
const hasStoreBadge = Boolean(stores.appStore || stores.googlePlay);

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const absolute = (path: string) => new URL(path, Astro.site).toString();

// Görsellerin optimize edilmiş adresleri hem sayfada hem şemada kullanılıyor;
// aynı getImage çağrısından geldikleri için şemadaki adres sayfada gerçekten
// yayınlanan dosyayı gösteriyor. Kaynak dosyanın kendi yolunu (logo.src)
// şemaya yazmak, o dosya derlemede yayınlanmayabildiği için güvenli değil.
//
// Şemadaki screenshot listesi özellik bloklarının görsellerinden geliyor:
// ayrı bir ekran görüntüsü galerisi yok, ama o görseller sayfada duruyor;
// yani şema yine yalnızca ziyaretçinin gördüğü dosyaları bildiriyor.
// FeatureRow da aynı genişliği kullandığı için adresler birebir aynı.
const featureShots = await Promise.all(
  features
    .map((feature) => feature.image)
    .filter((image) => Boolean(image))
    .map((image) => getImage({ src: image!, ...productImageOptions(image!) }))
);
const renderedLogo = logo ? await getImage({ src: logo, width: 128 }) : null;

// Video varken kapak poster olarak kullanılır: sayfa ilk boyandığında yine
// optimize görsel görünür (LCP değişmez), video görünür olana kadar tek bayt
// inmez (preload="none" + aşağıdaki görünürlük script'i).
const renderedCover =
  video && cover
    ? await getImage({ src: cover, ...productImageOptions(cover) })
    : null;

// VideoObject şeması: video gerçekten sayfada oynadığı için bildirilebilir.
const videoSchema =
  video && renderedCover
    ? {
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: title,
        description: promise,
        thumbnailUrl: absolute(renderedCover.src),
        contentUrl: absolute(video.src),
        uploadDate: video.uploadDate.toISOString().split('T')[0],
      }
    : null;

// SoftwareApplication şeması.
//
// aggregateRating iki koşulu birden geçmek zorunda:
//   1. Puan sayfada da görünüyor olmalı. Google, kullanıcıya gösterilmeyen
//      puanı yapılandırılmış veride bildirmeyi kural ihlali sayıyor; aşağıdaki
//      kanıt şeridi rating varsa her zaman Rating bileşenini bastığı için bu
//      koşul rating alanının kendisine bağlı.
//   2. Puan gerçek olmalı. Düzeni görmek için doldurulmuş örnek bir puan
//      sayfada durabilir ama şemaya giremez — uydurma bir değeri arama
//      motoruna bildirmek manuel işleme yol açar.
const ratingIsReal = Boolean(rating) && !isPlaceholder(project.data, 'rating');
const appSchema = app
  ? {
      '@context': 'https://schema.org',
      '@type': app.schemaType,
      name: title,
      description,
      url: canonical,
      applicationCategory: app.applicationCategory,
      operatingSystem: app.operatingSystem,
      offers: {
        '@type': 'Offer',
        price: app.price,
        priceCurrency: app.priceCurrency,
      },
      ...(renderedLogo ? { image: absolute(renderedLogo.src) } : {}),
      ...(featureShots.length > 0
        ? { screenshot: featureShots.map((shot) => absolute(shot.src)) }
        : {}),
      ...(hasStoreBadge
        ? {
            installUrl: [stores.appStore, stores.googlePlay].filter(Boolean),
          }
        : {}),
      ...(rating && ratingIsReal
        ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: rating.value,
              ratingCount: rating.count,
              bestRating: 5,
              worstRating: 1,
            },
          }
        : {}),
    }
  : null;

const faqSchema =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : null;
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  alternate={alternate}
  ogType="article"
  back={{ href: routes[lang].projects, label: t('nav.projects') }}
>
  {/* Tek bir Fragment: slot ataması koşullu ifadenin dışında kalsın. */}
  <Fragment slot="head">
    {
      appSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
      )
    }
    {
      faqSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
      )
    }
    {
      videoSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
      )
    }
  </Fragment>

  {/* 1 — Hero */}
  <section class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
    {/* Telefon ekranı metnin yanında dar bir sütunda durur. Yatay bir
        masaüstü görüntüsü yarım sütuna sığdırılınca okunmaz hâle geliyordu
        (2026-09-01); o yüzden metnin altına, tam genişlikte iner. */}
    <div
      class:list={[
        'grid items-center gap-10',
        !(cover && isLandscape(cover)) && 'md:grid-cols-2',
      ]}
    >
      <div>
        <div class="flex items-center gap-4">
          {
            logo && (
              <Image
                src={logo}
                alt=""
                width={128}
                loading="eager"
                class="h-16 w-16 shrink-0 rounded-2xl border border-line"
              />
            )
          }
          <h1 class="text-3xl font-bold text-ink-strong sm:text-4xl">{title}</h1>
        </div>

        <ProductMeta
          status={status}
          category={category}
          platforms={platforms}
          price={pricing?.label}
          lang={lang}
          class="mt-5"
        />

        <p class="mt-5 text-lg text-ink-muted">{promise}</p>

        <StoreBadges stores={stores} lang={lang} class="mt-7" />

        {/* Web adresi ve mağaza dışı bağlantılar: rozetlerin yanında ikinci
            derece, metin bağlantısı olarak. */}
        {
          (stores.web || links.length > 0) && (
            <ul class="mt-4 flex flex-wrap items-center gap-x-6">
              {stores.web && (
                <li>
                  <a
                    href={stores.web}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex min-h-11 items-center text-sm font-semibold text-action-ink hover:underline"
                  >
                    {t('product.website')}
                  </a>
                </li>
              )}
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex min-h-11 items-center text-sm font-semibold text-action-ink hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        {
          social.length > 0 && (
            <SocialLinks links={social} name={title} class="mt-3 -ml-2.5" />
          )
        }
      </div>

      {
        video && renderedCover ? (
          <div class="flex justify-center">
            {/* Tanıtım videosu. preload="none": görünürlük script'i oynatana
                kadar video inmez; ziyaretçi o âna dek poster'ı (optimize
                kapak görseli) görür. muted + playsinline mobilde kendiliğinden
                oynamanın önkoşulu; hareket azaltma tercihinde script oynatmaz,
                kontrolleri açar. */}
            <video
              data-hero-video
              poster={renderedCover.src}
              preload="none"
              muted
              loop
              playsinline
              width={renderedCover.attributes.width}
              height={renderedCover.attributes.height}
              class="w-full max-w-[300px] rounded-3xl border border-line shadow-lg"
            >
              <source src={video.src} type="video/mp4" />
            </video>
          </div>
        ) : (
          cover && (
            <div class="flex justify-center">
              {/* Sayfanın en üstündeki büyük görsel, yani LCP öğesi. Astro'nun
                  varsayılanı lazy; burada bırakılırsa tarayıcı bu görseli
                  keşfetmek için düzen hesabını bekler ve LCP gecikir. */}
              <Image
                src={cover}
                alt=""
                {...productImageOptions(cover)}
                loading="eager"
                fetchpriority="high"
                class:list={[
                  'w-full border border-line shadow-lg',
                  isLandscape(cover) ? 'rounded-2xl' : 'max-w-[300px] rounded-3xl',
                ]}
              />
            </div>
          )
        )
      }
    </div>
  </section>

  {/* 2 — Kanıt şeridi: puan ve sayılar, sayfanın geri kalanından ayrı bantta */}
  {
    (rating || results.length > 0) && (
      <section class="border-y border-line bg-surface-muted">
        <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-12 gap-y-6 px-4 py-8">
          {rating && <Rating value={rating.value} count={rating.count} lang={lang} />}
          {results.length > 0 && (
            <dl class="flex flex-wrap gap-x-12 gap-y-6">
              {results.map((result) => (
                <div>
                  <dt class="text-2xl font-bold text-ink-strong">{result.value}</dt>
                  <dd class="mt-1 text-sm text-ink-muted">{result.label}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </section>
    )
  }

  {/* 3 — Özellikler */}
  {
    features.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 py-16">
        <h2 class="text-2xl font-bold text-ink-strong">{t('product.features')}</h2>
        <div class="mt-10 flex flex-col gap-14">
          {features.map((feature, i) => (
            <FeatureRow
              title={feature.title}
              text={feature.text}
              image={feature.image}
              alt={feature.alt}
              reverse={i % 2 === 1}
            />
          ))}
        </div>
      </section>
    )
  }

  {/* 4 — Anlatı: neden yaptık, nasıl geliştirdik */}
  <section class="mx-auto max-w-3xl px-4 pb-16">
    <div class="prose prose-neutral max-w-none dark:prose-invert">
      <Content />
    </div>
  </section>

  {/* 5 — Yorumlar */}
  {
    testimonials.length > 0 && (
      <section class="border-t border-line bg-surface-muted">
        <div class="mx-auto max-w-5xl px-4 py-16">
          <h2 class="text-2xl font-bold text-ink-strong">
            {t('product.testimonials')}
          </h2>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2">
            {testimonials.map((testimonial) => (
              <li class="rounded-2xl border border-line bg-surface p-6">
                <figure>
                  <blockquote class="text-ink">
                    <p>{testimonial.quote}</p>
                  </blockquote>
                  <figcaption class="mt-4 text-sm text-ink-subtle">
                    <span class="font-semibold text-ink-soft">{testimonial.author}</span>
                    {testimonial.role && <> &middot; {testimonial.role}</>}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {/* 6 — SSS */}
  {
    faq.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 pb-16">
        <h2 class="text-2xl font-bold text-ink-strong">{t('product.faq')}</h2>
        <Faq items={faq} class="mt-6" />
      </section>
    )
  }

  {/* 7 — Kapanış: ürün mağazadaysa indirme çağrısı, değilse iletişim */}
  <section class="mx-auto max-w-5xl px-4 pb-20">
    <div class="rounded-2xl border border-line bg-surface-muted p-8 text-center sm:p-12">
      {
        hasStoreBadge ? (
          <>
            <h2 class="text-2xl font-bold text-ink-strong">
              {t('product.ctaStoreTitle')}
            </h2>
            <p class="mx-auto mt-3 max-w-xl text-ink-muted">
              {t('product.ctaStoreText')}
            </p>
            <StoreBadges stores={stores} lang={lang} class="mt-6 justify-center" />
          </>
        ) : (
          <>
            <h2 class="text-2xl font-bold text-ink-strong">
              {t('product.ctaContactTitle')}
            </h2>
            <p class="mx-auto mt-3 max-w-xl text-ink-muted">
              {t('product.ctaContactText')}
            </p>
            <a
              href={routes[lang].contact}
              class="mt-6 inline-flex min-h-11 items-center rounded-lg bg-action px-6 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
            >
              {t('product.ctaContactLink')}
            </a>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Tanıtım videosu: hero görünür olunca oynat — o âna kadar preload="none"
  // sayesinde video hiç inmez, ziyaretçi poster'ı görür. Hareket azaltma
  // tercihinde kendiliğinden oynatma yok; kontroller açılır, karar
  // ziyaretçinin olur. Oynatma engellenirse de aynı çıkışa düşülür.
  const video = document.querySelector('[data-hero-video]');
  if (video instanceof HTMLVideoElement) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.controls = true;
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            observer.disconnect();
            video.muted = true;
            video.play().catch(() => {
              video.controls = true;
            });
          }
        },
        { threshold: 0.4 }
      );
      observer.observe(video);
    }
  }
</script>
