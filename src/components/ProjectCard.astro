---
// Ürün kartı: hem ürünler listesinde hem ana sayfada kullanılır.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
  href: string;
  /** Kartın alt köşesindeki bağlantı metni (ör. "İncele"). */
  linkLabel: string;
  /** Başlık seviyesi: listede h2, ana sayfada bölüm başlığının altında h3. */
  as?: 'h2' | 'h3';
}

const { project, href, linkLabel, as: Heading = 'h3' } = Astro.props;
const { title, description, logo, cover, results } = project.data;
---

<a
  href={href}
  class="group grid overflow-hidden rounded-2xl border border-neutral-200 transition hover:border-brand/40 hover:shadow-lg sm:grid-cols-5"
>
  {
    cover && (
      <div class="flex items-center justify-center bg-neutral-50 p-8 sm:col-span-2">
        <Image
          src={cover}
          alt=""
          width={440}
          class="w-full max-w-[200px] rounded-xl border border-neutral-200 shadow-sm"
        />
      </div>
    )
  }
  <div
    class:list={[
      'flex flex-col justify-center gap-4 p-8',
      cover ? 'sm:col-span-3' : 'sm:col-span-5',
    ]}
  >
    <div class="flex items-center gap-3">
      {
        logo && (
          <Image
            src={logo}
            alt=""
            width={80}
            class="h-10 w-10 shrink-0 rounded-lg border border-neutral-200"
          />
        )
      }
      <Heading class="text-xl font-bold text-neutral-900">{title}</Heading>
    </div>

    <p class="text-neutral-600">{description}</p>

    {
      results.length > 0 && (
        <dl class="flex flex-wrap gap-x-6 gap-y-2 border-t border-neutral-200 pt-4">
          {results.map((result) => (
            <div class="flex items-baseline gap-1.5">
              <dt class="font-bold text-neutral-900">{result.value}</dt>
              <dd class="text-sm text-neutral-500">{result.label}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <span class="text-sm font-semibold text-action">
      {linkLabel}{' '}
      <span
        class="inline-block transition-transform group-hover:translate-x-1"
        aria-hidden="true">&rarr;</span
      >
    </span>
  </div>
</a>
