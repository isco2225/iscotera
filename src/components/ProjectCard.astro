---
// Ürün kartı: hem ürünler listesinde hem ana sayfada kullanılır.
//
// Bilgi sırası kartın işini yapması için önemli: önce ne olduğu (logo +
// başlık), sonra güvenilir mi (durum/tür/platform), sonra ne vaat ettiği
// (tagline), sonra başkaları ne demiş (puan), en sonda ölçülebilir sonuçlar.
// Ziyaretçi kartı yarısında bıraksa bile en değerli iki satırı okumuş oluyor.

import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ProductMeta from './ProductMeta.astro';
import Rating from './Rating.astro';
import { platformLabels } from '../utils/product';
import type { Lang } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  href: string;
  /** Kartın alt köşesindeki bağlantı metni (ör. "İncele"). */
  linkLabel: string;
  lang: Lang;
  /** Başlık seviyesi: listede h2, ana sayfada bölüm başlığının altında h3. */
  as?: 'h2' | 'h3';
}

const { project, href, linkLabel, lang, as: Heading = 'h3' } = Astro.props;
const { title, description, tagline, status, category, rating, logo, cover, results } =
  project.data;

const platforms = platformLabels(project.data);
---

<a
  href={href}
  class="group grid overflow-hidden rounded-2xl border border-line transition hover:border-brand/40 hover:shadow-lg sm:grid-cols-5"
>
  {
    cover && (
      <div class="flex items-center justify-center bg-surface-muted p-8 sm:col-span-2">
        <Image
          src={cover}
          alt=""
          width={440}
          class="w-full max-w-[200px] rounded-xl border border-line shadow-sm"
        />
      </div>
    )
  }
  <div
    class:list={[
      'flex flex-col justify-center gap-4 p-8',
      cover ? 'sm:col-span-3' : 'sm:col-span-5',
    ]}
  >
    <div class="flex items-center gap-3">
      {
        logo && (
          <Image
            src={logo}
            alt=""
            width={80}
            class="h-10 w-10 shrink-0 rounded-lg border border-line"
          />
        )
      }
      <Heading class="text-xl font-bold text-ink-strong">{title}</Heading>
    </div>

    <ProductMeta
      status={status}
      category={category}
      platforms={platforms}
      lang={lang}
    />

    <p class="text-ink-muted">{tagline ?? description}</p>

    {rating && <Rating value={rating.value} count={rating.count} lang={lang} />}

    {
      results.length > 0 && (
        <dl class="flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-4">
          {results.map((result) => (
            <div class="flex items-baseline gap-1.5">
              <dt class="font-bold text-ink-strong">{result.value}</dt>
              <dd class="text-sm text-ink-subtle">{result.label}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <span class="text-sm font-semibold text-action-ink">
      {linkLabel}{' '}
      <span
        class="inline-block transition-transform group-hover:translate-x-1"
        aria-hidden="true">&rarr;</span
      >
    </span>
  </div>
</a>
