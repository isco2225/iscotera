// Gerçek içerik geldikçe bu bileşen kullanımdan kalkacak.

interface Props {
  note: string;
}

const { note } = Astro.props;
---

<div
  class="rounded-lg border-2 border-dashed border-neutral-300 bg-neutral-50 p-8 text-center text-sm text-neutral-400"
>
  {note}
</div>
