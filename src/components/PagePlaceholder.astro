---
// İçeriği henüz yazılmamış bölümler için geçici kutu.
// Gerçek içerik geldikçe bu bileşen kullanımdan kalkacak.

interface Props {
  note: string;
}

const { note } = Astro.props;
---

<div
  class="rounded-lg border-2 border-dashed border-line-strong bg-surface-muted p-8 text-center text-sm text-ink-faint"
>
  {note}
</div>
