---
import { routes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Aynı sayfanın diğer dildeki yolu; dil değiştirici bunu kullanır. */
  alternate?: string;
}

const { lang, alternate } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];

// Blog bilinçli olarak menüde yok: 3-4 yazı yayınlanana kadar gizli kalacak.
// Eklemek için: { href: r.blog, label: t('nav.blog') }
const navItems = [
  { href: r.about, label: t('nav.about') },
  { href: r.services, label: t('nav.services') },
  { href: r.projects, label: t('nav.projects') },
  { href: r.contact, label: t('nav.contact') },
];

const otherLang: Lang = lang === 'tr' ? 'en' : 'tr';
const switchHref = alternate ?? routes[otherLang].home;
const currentPath = Astro.url.pathname;
---

<header class="border-b border-slate-200">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-4 py-4">
    <a href={r.home} class="text-xl font-bold tracking-tight text-slate-900">
      İscotera
    </a>

    <nav aria-label={lang === 'tr' ? 'Ana menü' : 'Main menu'}>
      <ul class="flex items-center gap-4 text-sm sm:gap-6">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
                class:list={[
                  'transition-colors hover:text-slate-900',
                  currentPath === item.href
                    ? 'font-semibold text-slate-900'
                    : 'text-slate-600',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={switchHref}
            class="rounded border border-slate-300 px-2 py-1 text-xs font-semibold text-slate-600 transition-colors hover:border-slate-500 hover:text-slate-900"
            aria-label={otherLang === 'en' ? 'Switch to English' : "Türkçe'ye geç"}
          >
            {otherLang.toUpperCase()}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
