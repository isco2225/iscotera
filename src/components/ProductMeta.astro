---
// Ürünün künyesi: durum, tür, platform ve fiyat modeli tek şeritte.
//
// Rozetler bilerek renksiz: durumu rozetin *metni* söylüyor. Rengi tek
// anlam taşıyıcısı yapsaydık renk körü kullanıcı ile tek renkli baskıda bilgi
// kaybolurdu; ayrıca "yayında" için palette olmayan bir yeşil eklemek
// gerekirdi. Durum rozeti diğerlerinden yalnızca kontrastıyla ayrılıyor.

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  status: 'live' | 'beta' | 'development';
  /** Ürün türü, ör. "Mobil uygulama". */
  category?: string;
  /** Mağaza bağlantılarından türetilen platform adları. */
  platforms?: string[];
  /** Fiyat modeli etiketi, ör. "Ücretsiz". */
  price?: string;
  lang: Lang;
  class?: string;
}

const {
  status,
  category,
  platforms = [],
  price,
  lang,
  class: className,
} = Astro.props;

const t = useTranslations(lang);

const STATUS_KEYS = {
  live: 'product.status.live',
  beta: 'product.status.beta',
  development: 'product.status.development',
} as const;

const details = [category, ...platforms, price].filter(Boolean) as string[];
---

<ul class:list={['flex flex-wrap items-center gap-2', className]}>
  <li
    class="inline-flex items-center rounded-full border border-line-strong bg-surface-raised px-3 py-1 text-xs font-semibold text-ink-strong"
  >
    {t(STATUS_KEYS[status])}
  </li>
  {
    details.map((detail) => (
      <li class="inline-flex items-center rounded-full border border-line px-3 py-1 text-xs text-ink-muted">
        {detail}
      </li>
    ))
  }
</ul>
