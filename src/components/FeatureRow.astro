---
// Tek bir özellik: solda metin, sağda o özelliğin kendi ekranı. Sıradaki blok
// `reverse` ile ters çevrilir, böylece sayfa aşağı inerken göz iki yana
// dönüşümlü gider.
//
// Madde listesi yerine bunu tercih ettik: "zikirmatik var" cümlesi ile
// zikirmatiğin ekran görüntüsü yan yana durduğunda okuyucu özelliğin gerçekten
// nasıl göründüğünü görüyor, hayal etmek zorunda kalmıyor.

import { Image } from 'astro:assets';
import { PRODUCT_IMAGE_WIDTH } from '../utils/product';

interface Props {
  title: string;
  text: string;
  image?: ImageMetadata;
  alt?: string;
  /** Görseli sola, metni sağa alır. */
  reverse?: boolean;
}

const { title, text, image, alt, reverse = false } = Astro.props;
---

<div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
  <div class:list={[!image && 'md:col-span-2', reverse && 'md:order-2']}>
    <h3 class="text-xl font-bold text-ink-strong">{title}</h3>
    <p class="mt-3 text-ink-muted">{text}</p>
  </div>
  {
    image && (
      <div class:list={['flex justify-center', reverse && 'md:order-1']}>
        <Image
          src={image}
          alt={alt ?? ''}
          width={PRODUCT_IMAGE_WIDTH}
          class="w-full max-w-[320px] rounded-2xl border border-line shadow-sm"
        />
      </div>
    )
  }
</div>
