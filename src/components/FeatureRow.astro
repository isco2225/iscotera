---
// Tek bir özellik: solda metin, sağda o özelliğin kendi ekranı. Sıradaki blok
// `reverse` ile ters çevrilir, böylece sayfa aşağı inerken göz iki yana
// dönüşümlü gider.
//
// Madde listesi yerine bunu tercih ettik: "zikirmatik var" cümlesi ile
// zikirmatiğin ekran görüntüsü yan yana durduğunda okuyucu özelliğin gerçekten
// nasıl göründüğünü görüyor, hayal etmek zorunda kalmıyor.

import { Image } from 'astro:assets';
import { isLandscape, productImageOptions } from '../utils/product';

interface Props {
  title: string;
  text: string;
  image?: ImageMetadata;
  alt?: string;
  /** Görseli sola, metni sağa alır. */
  reverse?: boolean;
  /** Görselin altına basılan kısa not (ör. "veriler temsilidir"). */
  caption?: string;
}

const { title, text, image, alt, reverse = false, caption } = Astro.props;
// Yatay (masaüstü) görüntü yarım sütunda okunmuyor; metnin altına tam
// genişlikte iner ve sağ/sol dönüşümü uygulanmaz.
const wide = image ? isLandscape(image) : false;
---

<div
  class:list={[
    'grid items-center gap-8 md:gap-12',
    !wide && 'md:grid-cols-2',
  ]}
>
  <div class:list={[!image && 'md:col-span-2', !wide && reverse && 'md:order-2']}>
    <h3 class="text-xl font-bold text-ink-strong">{title}</h3>
    <p class="mt-3 text-ink-muted">{text}</p>
  </div>
  {
    image && (
      <figure
        class:list={['flex flex-col items-center', !wide && reverse && 'md:order-1']}
      >
        <Image
          src={image}
          alt={alt ?? ''}
          {...productImageOptions(image)}
          class:list={[
            'w-full rounded-2xl border border-line shadow-sm',
            !wide && 'max-w-[320px]',
          ]}
        />
        {caption && (
          <figcaption class="mt-2 text-center text-xs text-ink-subtle">{caption}</figcaption>
        )}
      </figure>
    )
  }
</div>
