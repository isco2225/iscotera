---
// İ monogramı: siyah kutu, beyaz gövde, kırmızı nokta. Header, footer ve
// blog yazılarındaki yazar satırı bu tek bileşeni kullanır; boyut `class`
// ile verilir (ör. "h-8 w-8").
//
// Kutu koyu zeminde kaybolmasın diye bir tık açılır ve saç teli bir kenarlık
// kazanır (--logo-tile / --logo-stroke, global.css). Kenarlığın kırpılmaması
// için dikdörtgen 1px içeri alındı.

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 64 64" class={className} aria-hidden="true">
  <rect
    x="1"
    y="1"
    width="62"
    height="62"
    rx="13"
    stroke-width="2"
    style="fill: var(--logo-tile); stroke: var(--logo-stroke)"></rect>
  <rect x="28" y="8" width="8" height="8" rx="4" style="fill: var(--color-brand)"></rect>
  <path d="M28 24 Q28 21 31 21 L33 21 Q36 21 36 24 L36 50 L28 56 Z" fill="#FFFFFF"></path>
</svg>
