---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { localeTag, organizationId } from '../utils/schema';
import planningImg from '../assets/about/planning.jpg';

// İlkeler, ana sayfadaki süreç adımlarının tekrarı değil: orası bir projede
// SIRAYLA NE OLDUĞUNU anlatıyor, burası NEDEN böyle çalıştığımızı. Buradaki
// sözler de tutulabilir olmalı — services.ts ve ana sayfa ile aynı kural:
// teklifte yazılı hâle gelmeyecek bir cümle buraya yazılmaz.
const principles = [
  {
    title: 'Önce gerekliliği değerlendiririz',
    text: 'Her ihtiyaç için yeni bir yazılım gerekmez. Hazır bir ürün ya da elinizdeki sistemde yapılacak bir iyileştirme yetecekse bunu açıkça söyleriz. Bizim için önemli olan, yıllarca birlikte çalışabileceğimiz bir ilişki kurmak.',
  },
  {
    title: 'Net bir tahmin vermek bizim işimiz',
    text: 'Süreyi ve maliyeti baştan netleştirmeyi kendi sorumluluğumuz sayıyoruz. Belirsiz kalan bir konuyu yuvarlak cümlelerle geçiştirmeyiz. İşin başında onayladığınız yazılı belge, proje bitene kadar iki tarafın da dayanağı olur.',
  },
  {
    title: 'Teknolojiyi ihtiyaca göre seçeriz',
    text: 'Her projeye aynı kalıbı uygulamayız. Seçimi projenin ölçeğine, bütçenize ve sistemi ileride kimin işleteceğine bakarak yaparız. Bir teknolojinin o dönem popüler olması, onu seçmemiz için yeterli olmaz.',
  },
  {
    title: 'Projeyi geliştiren ekiple doğrudan konuşursunuz',
    text: 'Sizinle geliştirme ekibi arasında aracı biri yok. Sorunuzu doğrudan yanıtı verecek kişiye sorarsınız. Böylece talebiniz doğru anlaşılır, yanlış anlamalar da erken fark edilir.',
  },
  {
    title: 'Sizi bize bağımlı bırakmayız',
    text: 'Kaynak kod, veriler ve hesaplar size ait. Mağaza ve sunucu hesaplarını sizin adınıza açıyoruz. İleride başka bir ekiple devam etmek isterseniz, çalışan sistem ve bütün erişim bilgileri sizde kalır.',
  },
  {
    title: 'Teslimden sonra da destek veririz',
    text: 'Bir ürünün asıl kullanımı yayına alındıktan sonra başlar. Kullanımda ortaya çıkan ihtiyaçlar, bakım ve yeni geliştirmeler için aynı ekip sizinle çalışmayı sürdürür.',
  },
];

// Sayfaya özel şema: AboutPage düğümü, BaseLayout'un her sayfada bastığı
// Organization'ı @id ile gösterir — firma bilgisi ikinci kez yazılmaz
// (gerekçe src/utils/schema.ts'te).
const canonical = new URL(Astro.url.pathname, Astro.site);
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Hakkımızda',
  url: canonical.toString(),
  inLanguage: localeTag('tr'),
  mainEntity: { '@id': organizationId(Astro.site) },
};
---

<BaseLayout
  title="Hakkımızda"
  description="İscotera'nın çalışma ilkeleri. Kapsamı, süreyi ve maliyeti yazılı olarak belirliyor, hesapları sizin adınıza açıyor, teslimden sonra da destek veriyoruz."
  lang="tr"
  alternate="/en/about/"
  back={{ href: '/', label: 'Ana Sayfa' }}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
  </Fragment>

  {/* 1 — Hero. İç sayfalar yazıyla açılır (fotoğraflı hero ana sayfaya ait);
      üstteki kırmızı etiket, hizmet sayfalarındaki kırmızı sıra numarasının
      karşılığı. */}
  <section class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
    <div class="max-w-3xl">
      <p class="text-xs font-bold tracking-[0.14em] text-brand uppercase">
        Hakkımızda
      </p>
      <h1 class="mt-3 text-3xl font-bold text-ink-strong sm:text-4xl">
        İş süreçlerinizi kolaylaştıran yazılımlar geliştiriyoruz
      </h1>
      <p class="mt-5 text-lg text-ink-muted">
        İscotera'da işletmeler ve kurumlar için web uygulamaları, mobil
        uygulamalar ve işe özel yazılımlar geliştiriyoruz. Müşteri
        projelerinin yanında kendi ürünlerimizi de yayına alıyoruz.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/iletisim/"
          class="inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
        >
          Bize ulaşın
        </a>
        <a
          href="/hizmetler/"
          class="inline-block rounded-lg border border-line-strong px-6 py-3 text-sm font-semibold text-ink-soft transition-colors hover:border-ink-subtle"
        >
          Hizmetlerimiz
        </a>
      </div>
    </div>
  </section>

  {/* 2 — Öngörülebilirlik: hizmet listesindeki şeritle aynı düzen (yazı +
      gerçek fotoğraf). Tek seferlik olduğu için bileşene çıkarılmadı. */}
  <section class="mx-auto max-w-5xl px-4 pb-14">
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-14">
      <div>
        <h2 class="text-2xl font-bold text-ink-strong">
          Projelerde öngörülebilirlik
        </h2>
        <p class="mt-4 leading-relaxed text-ink-muted">
          Yazılım projelerindeki sorunların önemli bir kısmı, işin nasıl
          yürütüldüğünden kaynaklanır. Süreler uzar, maliyet ilk tahmini aşar.
          Proje bittiğinde de sistemin nasıl çalıştığını yalnızca onu
          geliştiren firma bilir.
        </p>
        <p class="mt-4 leading-relaxed text-ink-muted">
          Bu riskleri azaltmak için her projeye yazılı bir çerçeveyle
          başlıyoruz. Kapsamı, süreyi ve maliyeti geliştirmeye başlamadan önce
          belgeliyoruz. Proje boyunca da ilerlemeyi sizinle şeffaf bir şekilde
          paylaşıyoruz. Mağaza ve sunucu hesaplarını sizin adınıza açıyoruz,
          verileriniz her zaman sizde kalıyor. Böylece iş, başından sonuna
          kadar öngörülebilir biçimde ilerler.
        </p>
      </div>
      <Image
        src={planningImg}
        alt="Masadaki belgelerin üzerinde kalem tutarak birlikte çalışan eller"
        width={980}
        class="h-64 w-full rounded-xl border border-line object-cover sm:h-72"
      />
    </div>
  </section>

  {/* 3 — İlkeler: soluk zeminli tam genişlik bant + kırmızı numaralar; hizmet
      detayındaki "Yaklaşımımız" bölümüyle aynı dil. */}
  <section class="border-y border-line bg-surface-muted">
    <div class="mx-auto max-w-5xl px-4 py-14">
      <h2 class="text-2xl font-bold text-ink-strong">Çalışma ilkelerimiz</h2>
      <p class="mt-3 max-w-2xl text-ink-muted">
        Bu ilkeler, teklif hazırlarken yazıya döktüğümüz sözler.
      </p>
      <div class="mt-8 grid gap-8 md:grid-cols-3 md:gap-x-10 md:gap-y-10">
        {
          principles.map((item, i) => (
            <div>
              <p class="text-sm font-extrabold text-brand">{i + 1}</p>
              <h3 class="mt-1.5 font-semibold text-ink-strong">{item.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">
                {item.text}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 4 — Kendi ürünlerimiz: genç bir firmanın sayı vermeden gösterebileceği en
      somut kanıt. Sayfa sayı/yıl/proje adedi iddia etmez (bilinçli karar). */}
  <section class="mx-auto max-w-5xl px-4 pt-14 pb-14">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold text-ink-strong">
        Kendi ürünlerimiz
      </h2>
      <p class="mt-4 leading-relaxed text-ink-muted">
        Kendi ürünlerimizi yalnızca geliştirmiyor, yayında tutup işletiyoruz
        da. Mağaza onay süreçlerini, kullanıcı geri bildirimlerini ve yayındaki
        bir uygulamanın bakımını bu ürünlerde kendimiz yaşıyoruz. Süre ve bakım
        tahminlerimizi de bu deneyime dayanarak veriyoruz.
      </p>
      <p class="mt-4 leading-relaxed text-ink-muted">
        İşimizi örnekler üzerinden görmek isterseniz, ürünlerimiz ve vaka
        çalışmalarımız Ürünler sayfasında duruyor. Nasıl çalıştığımızı da
        blogdaki yazılarımızda anlatıyoruz.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2">
        <a
          href="/urunler/"
          class="text-sm font-semibold text-action-ink hover:underline"
        >
          Ürünlerimizi inceleyin →
        </a>
        <a
          href="/blog/"
          class="text-sm font-semibold text-action-ink hover:underline"
        >
          Blog yazılarımızı okuyun →
        </a>
      </div>
    </div>
  </section>

  {/* 5 — Hizmetler: ana sayfadaki kart dizisinin aynısı, iç bağlantı için. */}
  <section class="mx-auto max-w-5xl px-4 pb-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-2xl font-bold text-ink-strong">Hizmetlerimiz</h2>
      <a
        href="/hizmetler/"
        class="shrink-0 text-sm font-semibold text-action-ink hover:underline"
      >
        Tüm hizmetler
      </a>
    </div>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={`/hizmetler/${service.tr.slug}/`}
            class="rounded-lg border border-line p-6 transition hover:border-brand/40 hover:shadow-md"
          >
            <h3 class="font-semibold text-ink-strong">{service.tr.title}</h3>
            <p class="mt-2 text-sm text-ink-muted">{service.tr.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  {/* 6 — Kapanış çağrısı (site genelindeki kutunun aynısı) */}
  <section class="mx-auto max-w-5xl px-4 pb-20">
    <div
      class="rounded-2xl border border-line bg-surface-muted p-8 text-center sm:p-12"
    >
      <h2 class="text-2xl font-bold text-ink-strong">
        Projenizi birlikte değerlendirelim
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-muted">
        İhtiyacınızı bize anlatın, süresi ve bütçesi net bir değerlendirmeyle
        size dönelim.
      </p>
      <a
        href="/iletisim/"
        class="mt-6 inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Bize ulaşın
      </a>
    </div>
  </section>
</BaseLayout>
