---
import BaseLayout from '../layouts/BaseLayout.astro';
import PagePlaceholder from '../components/PagePlaceholder.astro';
---

<BaseLayout
  title="Hakkımızda"
  description="Iscotera'nın hikayesi, vizyonu ve çalışma yaklaşımı."
  lang="tr"
  alternate="/en/about/"
>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-slate-900">Hakkımızda</h1>
    <div class="mt-8 space-y-6">
      <PagePlaceholder note="Firma hikayesi: Iscotera nasıl kuruldu, ne yapıyor, kimlere hizmet veriyor?" />
      <PagePlaceholder note="Vizyon ve çalışma yaklaşımı: nasıl çalışıyoruz, neye önem veriyoruz?" />
      <PagePlaceholder note="Ekip / kurucu tanıtımı (isteğe bağlı)" />
    </div>
  </section>
</BaseLayout>
