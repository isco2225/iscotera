---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readingTimeMinutes } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    ({ id, data }) => id.startsWith('tr/') && (import.meta.env.DEV || !data.draft)
  );
  return posts.map((post) => ({
    params: { slug: post.id.replace('tr/', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingTimeMinutes(post.body ?? '');

// Yazı sonunda önerilecek diğer yazılar (en yeni 3 tanesi)
const otherPosts = (
  await getCollection(
    'blog',
    ({ id, data }) =>
      id.startsWith('tr/') && (import.meta.env.DEV || !data.draft) && id !== post.id
  )
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang="tr"
  ogType="article"
  back={{ href: '/blog/', label: 'Blog' }}
>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <div class="flex items-center gap-2 text-sm text-neutral-500">
      <time datetime={post.data.pubDate.toISOString()}>
        {
          post.data.pubDate.toLocaleDateString('tr-TR', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </time>
      <span aria-hidden="true">·</span>
      <span>{minutes} dk okuma</span>
    </div>

    <h1 class="mt-3 text-3xl font-bold leading-tight text-neutral-900 sm:text-4xl">
      {post.data.title}
    </h1>

    {
      post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs text-neutral-600">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div class="mt-6 flex items-center gap-2.5 border-y border-neutral-200 py-4">
      <svg viewBox="0 0 64 64" class="h-7 w-7" aria-hidden="true">
        <rect width="64" height="64" rx="14" fill="#171717"></rect>
        <rect x="28" y="8" width="8" height="8" rx="4" fill="#E50914"></rect>
        <path d="M28 24 Q28 21 31 21 L33 21 Q36 21 36 24 L36 50 L28 56 Z" fill="#FFFFFF"></path>
      </svg>
      <span class="text-sm font-semibold text-neutral-800">İscotera Ekibi</span>
    </div>

    <div class="prose prose-neutral mt-8 max-w-none">
      <Content />
    </div>

    <aside class="mt-14 rounded-xl border border-neutral-200 bg-neutral-50 p-8">
      <h2 class="text-xl font-bold text-neutral-900">
        Bu konuyu işletmeniz için konuşalım
      </h2>
      <p class="mt-2 text-neutral-600">
        Süreçlerinize birlikte bakalım; size dürüst bir yol haritası çıkaralım.
      </p>
      <a
        href="/iletisim/"
        class="mt-5 inline-block rounded-lg bg-brand px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark"
      >
        Bize Ulaşın
      </a>
    </aside>

    {
      otherPosts.length > 0 && (
        <section class="mt-14 border-t border-neutral-200 pt-8">
          <h2 class="text-lg font-bold text-neutral-900">Diğer yazılar</h2>
          <ul class="mt-4 space-y-4">
            {otherPosts.map((other) => (
              <li>
                <a
                  href={`/blog/${other.id.replace('tr/', '')}/`}
                  class="group block"
                >
                  <span class="text-sm text-neutral-500">
                    {other.data.pubDate.toLocaleDateString('tr-TR', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </span>
                  <span class="block font-semibold text-neutral-900 transition-colors group-hover:text-brand">
                    {other.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
