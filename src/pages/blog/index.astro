---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PagePlaceholder from '../../components/PagePlaceholder.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('tr');

// Taslaklar sadece geliştirme ortamında görünür; yayında gizlenir.
const posts = (
  await getCollection(
    'blog',
    ({ id, data }) => id.startsWith('tr/') && (import.meta.env.DEV || !data.draft)
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog"
  description="İscotera ekibinden yazılım, teknoloji ve ürün geliştirme üzerine yazılar."
  lang="tr"
  alternate="/en/blog/"
  back={{ href: '/', label: 'Ana Sayfa' }}
>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-neutral-900">Blog</h1>

    <div class="mt-8">
      {
        posts.length === 0 ? (
          <PagePlaceholder note={t('blog.empty')} />
        ) : (
          <ul class="space-y-8">
            {posts.map((post) => (
              <li>
                <article>
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="text-sm text-neutral-500"
                  >
                    {post.data.pubDate.toLocaleDateString('tr-TR', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                  <h2 class="mt-1 text-xl font-semibold text-neutral-900">
                    <a
                      href={`/blog/${post.id.replace('tr/', '')}/`}
                      class="hover:underline"
                    >
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="mt-2 text-neutral-600">{post.data.description}</p>
                  <a
                    href={`/blog/${post.id.replace('tr/', '')}/`}
                    class="mt-2 inline-block text-sm font-semibold text-neutral-900 hover:underline"
                  >
                    {t('blog.readMore')} →
                  </a>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
