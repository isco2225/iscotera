---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { services } from '../../data/services';

// At most two products and two posts on the home page; the rest live in their
// own listings. Drafts only render in development.
const products = (
  await getCollection(
    'projects',
    ({ id, data }) => id.startsWith('en/') && (import.meta.env.DEV || !data.draft)
  )
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const posts = (
  await getCollection(
    'blog',
    ({ id, data }) => id.startsWith('en/') && (import.meta.env.DEV || !data.draft)
  )
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// Process steps. NOTE: the commitments here (two-week build cadence,
// ongoing support) have to be promises the team can keep.
const steps = [
  {
    title: 'Discovery',
    thesis: 'We start by talking about what not to build.',
    text: 'We go through what you need, what you already run and what your budget is. If custom software is not the right answer, we say so.',
  },
  {
    title: 'Planning',
    thesis: 'Timeline and cost, in writing, before a line of code.',
    text: 'We break the scope into items and put a duration and a price on each. The document you approve stays our shared reference to the end.',
  },
  {
    title: 'Building',
    thesis: 'You see progress along the way, not at the end.',
    text: 'We show a working version every two weeks. Correcting course early always costs less than discovering a surprise at the finish.',
  },
  {
    title: 'Launch and after',
    thesis: 'Our responsibility does not end at handover.',
    text: 'We take the product live and hand it over to your team. After that we stay on for maintenance and new features.',
  },
];
---

<BaseLayout
  title="İscotera — Software Solutions"
  description="A software company building web, mobile and custom software. Timeline and cost in writing up front, and a working version every two weeks."
  lang="en"
  alternate="/"
>
  <section class="mx-auto max-w-5xl px-4 py-20 text-center">
    <h1 class="text-4xl font-bold tracking-tight text-ink-strong sm:text-5xl">
      We build web, mobile and custom software
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-muted">
      You get the timeline and the cost in writing before a line of code, and a
      working version every two weeks.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a
        href="/en/contact/"
        class="rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Get in Touch
      </a>
      <a
        href="/en/products/"
        class="rounded-lg border border-line-strong px-6 py-3 text-sm font-semibold text-ink-soft transition-colors hover:border-ink-subtle"
      >
        Our Products
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-2xl font-bold text-ink-strong">Who we are</h2>
    <div class="mt-4 max-w-3xl space-y-4">
      <p class="text-lg text-ink-soft">
        İscotera builds web and mobile software for businesses. We see software
        as a tool that makes your work easier, not as an end in itself.
      </p>
      <p class="text-ink-muted">
        We pick the technology to fit what the project needs. Instead of
        applying the same solution to every job, we suggest what fits your
        budget and the size of the work. And because we build and publish our
        own products too, we know what a project brings after launch, not just
        during development.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-2xl font-bold text-ink-strong">Our Services</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={`/en/services/${service.en.slug}/`}
            class="rounded-lg border border-line p-6 transition hover:border-brand/40 hover:shadow-md"
          >
            <h3 class="font-semibold text-ink-strong">{service.en.title}</h3>
            <p class="mt-2 text-sm text-ink-muted">{service.en.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  {
    products.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 pb-16">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-2xl font-bold text-ink-strong">Our Products</h2>
          <a
            href="/en/products/"
            class="shrink-0 text-sm font-semibold text-action-ink hover:underline"
          >
            See all
          </a>
        </div>
        <div class="mt-6 flex flex-col gap-8">
          {products.map((product) => (
            <ProjectCard
              project={product}
              href={`/en/products/${product.id.replace('en/', '')}/`}
              linkLabel="View case study"
              lang="en"
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-2xl font-bold text-ink-strong">How we work</h2>
    <p class="mt-3 max-w-2xl text-ink-muted">
      At every stage you know what happens and what we decide together.
    </p>
    <ol class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        steps.map((step, i) => (
          <li class="rounded-lg border border-line p-5">
            <span class="text-xs font-bold text-brand">0{i + 1}</span>
            <h3 class="mt-1.5 font-semibold text-ink-strong">{step.title}</h3>
            <p class="mt-1.5 text-sm font-medium text-ink">{step.thesis}</p>
            <p class="mt-1.5 text-sm text-ink-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    posts.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 pb-16">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-2xl font-bold text-ink-strong">Latest posts</h2>
          <a
            href="/en/blog/"
            class="shrink-0 text-sm font-semibold text-action-ink hover:underline"
          >
            All posts
          </a>
        </div>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {posts.map((post) => (
            <a
              href={`/en/blog/${post.id.replace('en/', '')}/`}
              class="group rounded-lg border border-line p-6 transition hover:border-brand/40 hover:shadow-md"
            >
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-sm text-ink-subtle"
              >
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <h3 class="mt-2 font-semibold text-ink-strong transition-colors group-hover:text-action-ink">
                {post.data.title}
              </h3>
              <p class="mt-2 text-sm text-ink-muted">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-4 pb-20">
    <div
      class="rounded-2xl border border-line bg-surface-muted p-8 text-center sm:p-12"
    >
      <h2 class="text-2xl font-bold text-ink-strong">Have something in mind?</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-muted">
        Tell us what you want to build and we'll give you an honest assessment,
        a clear timeline and a budget.
      </p>
      <a
        href="/en/contact/"
        class="mt-6 inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>
