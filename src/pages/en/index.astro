---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { services } from '../../data/services';

// At most two products and two posts on the home page; the rest live in their
// own listings. Drafts only render in development.
const products = (
  await getCollection(
    'projects',
    ({ id, data }) => id.startsWith('en/') && (import.meta.env.DEV || !data.draft)
  )
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const posts = (
  await getCollection(
    'blog',
    ({ id, data }) => id.startsWith('en/') && (import.meta.env.DEV || !data.draft)
  )
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// TODO: Draft copy — review against how the team actually works.
const steps = [
  {
    title: "Let's talk",
    text: "We get clear on what you need and what your budget is. If you don't need software, we say so.",
  },
  {
    title: 'We plan',
    text: 'Scope, timeline and cost, in writing — so nothing surprises you later.',
  },
  {
    title: 'We build',
    text: 'You see a working version at regular intervals and we steer the direction together.',
  },
  {
    title: 'We ship',
    text: 'We launch the product and stay on for its maintenance afterwards.',
  },
];
---

<BaseLayout
  title="İscotera — Software Solutions"
  description="İscotera is a software company building web, mobile and custom software solutions."
  lang="en"
  alternate="/"
>
  <section class="mx-auto max-w-5xl px-4 py-20 text-center">
    <h1 class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
      From idea to product, software solutions
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600">
      We build your web, mobile and custom software projects end to end.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a
        href="/en/contact/"
        class="rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Get in Touch
      </a>
      <a
        href="/en/projects/"
        class="rounded-lg border border-neutral-300 px-6 py-3 text-sm font-semibold text-neutral-700 transition-colors hover:border-neutral-500"
      >
        Our Products
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-2xl font-bold text-neutral-900">Our Services</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={`/en/services/${service.en.slug}/`}
            class="rounded-lg border border-neutral-200 p-6 transition hover:border-brand/40 hover:shadow-md"
          >
            <h3 class="font-semibold text-neutral-900">{service.en.title}</h3>
            <p class="mt-2 text-sm text-neutral-600">{service.en.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  {
    products.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 pb-16">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-2xl font-bold text-neutral-900">Our Products</h2>
          <a
            href="/en/projects/"
            class="shrink-0 text-sm font-semibold text-action hover:underline"
          >
            See all
          </a>
        </div>
        <div class="mt-6 flex flex-col gap-8">
          {products.map((product) => (
            <ProjectCard
              project={product}
              href={`/en/projects/${product.id.replace('en/', '')}/`}
              linkLabel="View case study"
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-2xl font-bold text-neutral-900">How we work</h2>
    <p class="mt-3 max-w-2xl text-neutral-600">
      We keep the process open from start to finish, so you always know what
      happens at each stage.
    </p>
    <ol class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        steps.map((step, i) => (
          <li class="rounded-lg border border-neutral-200 p-6">
            <span class="text-sm font-bold text-brand">0{i + 1}</span>
            <h3 class="mt-2 font-semibold text-neutral-900">{step.title}</h3>
            <p class="mt-2 text-sm text-neutral-600">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    posts.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 pb-16">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-2xl font-bold text-neutral-900">Latest posts</h2>
          <a
            href="/en/blog/"
            class="shrink-0 text-sm font-semibold text-action hover:underline"
          >
            All posts
          </a>
        </div>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {posts.map((post) => (
            <a
              href={`/en/blog/${post.id.replace('en/', '')}/`}
              class="group rounded-lg border border-neutral-200 p-6 transition hover:border-brand/40 hover:shadow-md"
            >
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-sm text-neutral-500"
              >
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <h3 class="mt-2 font-semibold text-neutral-900 transition-colors group-hover:text-action">
                {post.data.title}
              </h3>
              <p class="mt-2 text-sm text-neutral-600">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-4 pb-20">
    <div
      class="rounded-2xl border border-neutral-200 bg-neutral-50 p-8 text-center sm:p-12"
    >
      <h2 class="text-2xl font-bold text-neutral-900">Have something in mind?</h2>
      <p class="mx-auto mt-3 max-w-xl text-neutral-600">
        Tell us what you want to build and we'll give you an honest assessment,
        a clear timeline and a budget.
      </p>
      <a
        href="/en/contact/"
        class="mt-6 inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>
