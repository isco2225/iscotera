---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PagePlaceholder from '../../../components/PagePlaceholder.astro';
import { useTranslations } from '../../../i18n/ui';
import { readingTimeMinutes } from '../../../utils/readingTime';

const t = useTranslations('en');

// Drafts are visible in dev only; hidden in production builds.
const posts = (
  await getCollection(
    'blog',
    ({ id, data }) => id.startsWith('en/') && (import.meta.env.DEV || !data.draft)
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog"
  description="Articles on software, technology and product development from the İscotera team."
  lang="en"
  alternate="/blog/"
  back={{ href: '/en/', label: 'Home' }}
>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-neutral-900">Blog</h1>
    <p class="mt-3 text-neutral-600">
      Our thoughts on software, technology and product development.
    </p>

    <div class="mt-10">
      {
        posts.length === 0 ? (
          <PagePlaceholder note={t('blog.empty')} />
        ) : (
          <ul class="space-y-6">
            {posts.map((post) => {
              const slug = post.id.replace('en/', '');
              const minutes = readingTimeMinutes(post.body ?? '');
              return (
                <li>
                  <a
                    href={`/en/blog/${slug}/`}
                    class="group block rounded-xl border border-neutral-200 p-6 transition hover:border-brand/40 hover:shadow-md sm:p-8"
                  >
                    <article>
                      <div class="flex items-center gap-2 text-sm text-neutral-500">
                        <time datetime={post.data.pubDate.toISOString()}>
                          {post.data.pubDate.toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                          })}
                        </time>
                        <span aria-hidden="true">·</span>
                        <span>{minutes} min read</span>
                      </div>
                      <h2 class="mt-2 text-2xl font-bold text-neutral-900 transition-colors group-hover:text-action">
                        {post.data.title}
                      </h2>
                      <p class="mt-2 leading-relaxed text-neutral-600">
                        {post.data.description}
                      </p>
                      {post.data.tags.length > 0 && (
                        <div class="mt-3 flex flex-wrap gap-2">
                          {post.data.tags.map((tag) => (
                            <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs text-neutral-600">
                              {tag}
                            </span>
                          ))}
                        </div>
                      )}
                      <span class="mt-4 inline-block text-sm font-semibold text-action">
                        {t('blog.readMore')} →
                      </span>
                    </article>
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
