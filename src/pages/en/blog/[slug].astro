---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readingTimeMinutes } from '../../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    ({ id, data }) => id.startsWith('en/') && (import.meta.env.DEV || !data.draft)
  );
  return posts.map((post) => ({
    params: { slug: post.id.replace('en/', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingTimeMinutes(post.body ?? '');

// Up to three other recent posts suggested at the end of the article
const otherPosts = (
  await getCollection(
    'blog',
    ({ id, data }) =>
      id.startsWith('en/') && (import.meta.env.DEV || !data.draft) && id !== post.id
  )
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang="en"
  ogType="article"
  back={{ href: '/en/blog/', label: 'Blog' }}
>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <div class="flex items-center gap-2 text-sm text-ink-subtle">
      <time datetime={post.data.pubDate.toISOString()}>
        {
          post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
    </div>

    <h1 class="mt-3 text-3xl font-bold leading-tight text-ink-strong sm:text-4xl">
      {post.data.title}
    </h1>

    {
      post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded-full bg-surface-raised px-3 py-1 text-xs text-ink-muted">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div class="mt-6 flex items-center gap-2.5 border-y border-line py-4">
      <svg viewBox="0 0 64 64" class="h-7 w-7" aria-hidden="true">
        <rect
          x="1"
          y="1"
          width="62"
          height="62"
          rx="13"
          stroke-width="2"
          style="fill: var(--logo-tile); stroke: var(--logo-stroke)"></rect>
        <rect
          x="28"
          y="8"
          width="8"
          height="8"
          rx="4"
          style="fill: var(--color-brand)"></rect>
        <path d="M28 24 Q28 21 31 21 L33 21 Q36 21 36 24 L36 50 L28 56 Z" fill="#FFFFFF"></path>
      </svg>
      <span class="text-sm font-semibold text-ink">İscotera Team</span>
    </div>

    <div class="prose prose-neutral mt-8 max-w-none dark:prose-invert">
      <Content />
    </div>

    <aside class="mt-14 rounded-xl border border-line bg-surface-muted p-8">
      <h2 class="text-xl font-bold text-ink-strong">
        Let's talk about this for your business
      </h2>
      <p class="mt-2 text-ink-muted">
        We'll look at your processes together and give you an honest roadmap.
      </p>
      <a
        href="/en/contact/"
        class="mt-5 inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Get in Touch
      </a>
    </aside>

    {
      otherPosts.length > 0 && (
        <section class="mt-14 border-t border-line pt-8">
          <h2 class="text-lg font-bold text-ink-strong">More posts</h2>
          <ul class="mt-4 space-y-4">
            {otherPosts.map((other) => (
              <li>
                <a
                  href={`/en/blog/${other.id.replace('en/', '')}/`}
                  class="group block"
                >
                  <span class="text-sm text-ink-subtle">
                    {other.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </span>
                  <span class="block font-semibold text-ink-strong transition-colors group-hover:text-action-ink">
                    {other.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
