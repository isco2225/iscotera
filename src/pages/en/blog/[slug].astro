---
import { getCollection, render } from 'astro:content';
import Logo from '../../../components/Logo.astro';
import { getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { blogPostingSchema } from '../../../utils/schema';
import { readingTimeMinutes } from '../../../utils/readingTime';
import { blogCoverOptions } from '../../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    ({ id, data }) => id.startsWith('en/') && (import.meta.env.DEV || !data.draft)
  );
  return posts.map((post) => ({
    params: { slug: post.id.replace('en/', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingTimeMinutes(post.body ?? '');

// Up to three other recent posts suggested at the end of the article
const otherPosts = (
  await getCollection(
    'blog',
    ({ id, data }) =>
      id.startsWith('en/') && (import.meta.env.DEV || !data.draft) && id !== post.id
  )
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Yazının BlogPosting şeması: sayfada görünen başlık, tarih ve
// etiketlerin yapılandırılmış karşılığı. Firma bilgisi BaseLayout'taki
// Organization düğümünden @id ile geliyor.
// Kapak bir kez üretilir: aynı dosya hem sayfadaki <img> hem de şemadaki
// `image` olur; ikinci bir üretim tarayıcıya ikinci bir dosya indirtirdi.
const cover = post.data.cover
  ? await getImage({ src: post.data.cover, ...blogCoverOptions })
  : undefined;
// getImage'ın hazır nitelikleri loading="lazy" taşır; kapak sayfanın üstündeki
// en büyük görsel (LCP) olduğu için o değer aşağıda eager ile değiştiriliyor.
const { loading: _lazy, ...coverAttrs } = cover?.attributes ?? {};

const postSchema = blogPostingSchema({
  post,
  canonical: new URL(Astro.url.pathname, Astro.site),
  site: Astro.site,
  lang: 'en',
  image: cover ? new URL(cover.src, Astro.site).toString() : undefined,
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang="en"
  ogType="article"
  back={{ href: '/en/blog/', label: 'Blog' }}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(postSchema)} />
  </Fragment>

  <article class="mx-auto max-w-3xl px-4 py-16">
    <div class="flex items-center gap-2 text-sm text-ink-subtle">
      <time datetime={post.data.pubDate.toISOString()}>
        {
          post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
    </div>

    <h1 class="mt-3 text-3xl font-bold leading-tight text-ink-strong sm:text-4xl">
      {post.data.title}
    </h1>

    {
      post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded-full bg-surface-raised px-3 py-1 text-xs text-ink-muted">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div class="mt-6 flex items-center gap-2.5 border-y border-line py-4">
      <Logo class="h-7 w-7" />
      <span class="text-sm font-semibold text-ink">İscotera Team</span>
    </div>

    {
      cover && (
        <img
          src={cover.src}
          srcset={cover.srcSet.attribute || undefined}
          {...coverAttrs}
          alt={post.data.coverAlt ?? ''}
          loading="eager"
          fetchpriority="high"
          class="mt-8 w-full rounded-2xl border border-line"
        />
      )
    }

    <div class="prose prose-neutral mt-8 max-w-none dark:prose-invert">
      <Content />
    </div>

    <aside class="mt-14 rounded-xl border border-line bg-surface-muted p-8">
      <h2 class="text-xl font-bold text-ink-strong">
        Let's talk about this for your business
      </h2>
      <p class="mt-2 text-ink-muted">
        We'll review your processes together and share our recommendations as a written roadmap.
      </p>
      <a
        href="/en/contact/"
        class="mt-5 inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Get in Touch
      </a>
    </aside>

    {
      otherPosts.length > 0 && (
        <section class="mt-14 border-t border-line pt-8">
          <h2 class="text-lg font-bold text-ink-strong">More posts</h2>
          <ul class="mt-4 space-y-4">
            {otherPosts.map((other) => (
              <li>
                <a
                  href={`/en/blog/${other.id.replace('en/', '')}/`}
                  class="group block"
                >
                  <span class="text-sm text-ink-subtle">
                    {other.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </span>
                  <span class="block font-semibold text-ink-strong transition-colors group-hover:text-action-ink">
                    {other.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
