---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { services } from '../../../data/services';
---

<BaseLayout
  title="Services"
  description="Software services offered by İscotera: web applications, mobile apps, custom software and consulting."
  lang="en"
  alternate="/hizmetler/"
  back={{ href: '/en/', label: 'Home' }}
>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-bold text-ink-strong">Our Services</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      End-to-end software services tailored to your needs.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={`/en/services/${service.en.slug}/`}
            class="rounded-lg border border-line p-6 transition hover:border-brand/40 hover:shadow-md"
          >
            <h2 class="font-semibold text-ink-strong">{service.en.title}</h2>
            <p class="mt-2 text-sm text-ink-muted">{service.en.summary}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
