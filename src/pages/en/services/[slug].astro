---
// İnce rota: sayfanın tamamı ServicePage bileşeninde. İki dilin rotası da aynı
// bileşeni çağırır; bölüm sırası orada tek yerden yönetilir.
import ServicePage from '../../../components/ServicePage.astro';
import { services } from '../../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.en.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<ServicePage service={service} lang="en" />
