---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PagePlaceholder from '../../../components/PagePlaceholder.astro';
import { services } from '../../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.en.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout
  title={service.en.title}
  description={service.en.summary}
  lang="en"
  alternate={`/hizmetler/${service.tr.slug}/`}
>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-neutral-900">{service.en.title}</h1>
    <p class="mt-3 text-lg text-neutral-600">{service.en.summary}</p>
    <div class="mt-8 space-y-6">
      <PagePlaceholder note="Detailed description: scope, process, technologies used..." />
      <PagePlaceholder note="Related projects / references" />
      <PagePlaceholder note="Frequently asked questions (valuable for SEO)" />
    </div>
    <div class="mt-10">
      <a
        href="/en/contact/"
        class="inline-block rounded-lg bg-brand px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark"
      >
        Let's Talk About Your Project
      </a>
    </div>
  </section>
</BaseLayout>
