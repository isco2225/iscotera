---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';
import { localeTag, organizationId } from '../../utils/schema';
import planningImg from '../../assets/about/planning.jpg';

// İlkeler, ana sayfadaki süreç adımlarının tekrarı değil: orası bir projede
// SIRAYLA NE OLDUĞUNU anlatıyor, burası NEDEN böyle çalıştığımızı. Türkçe
// sayfadaki liste ile aynı sırada durmalı (statik sayfaların metni dil başına
// yazılıyor, bu yüzden değişiklik iki dosyada birden yapılır).
const principles = [
  {
    title: 'First, we check whether software is needed',
    text: "Not every need calls for new software. If an existing product or an improvement to your current system will do the job, we'll tell you. What matters to us is a working relationship we can keep for years.",
  },
  {
    title: 'Giving you a clear estimate is our job',
    text: 'We treat pinning down the timeline and cost as our responsibility, and we do not gloss over open questions with vague answers. The written document you approve at the start is what we both work from until the project is finished.',
  },
  {
    title: 'We choose technology to fit the need',
    text: 'We do not apply the same approach to every project. We choose based on the scale of the project, your budget and who will run the system later. A technology being popular is not, on its own, a reason to use it.',
  },
  {
    title: 'You work directly with the team building your project',
    text: 'There is no one in between you and the development team. You put your questions straight to the person who will answer them, so your requests are understood and misunderstandings come to light early.',
  },
  {
    title: "We don't lock you in",
    text: 'The source code, data and accounts belong to you, and we open store and server accounts in your name. If you later decide to continue with another team, you keep a working system and all the access details.',
  },
  {
    title: 'We keep supporting you after launch',
    text: 'A product only starts being really used once it goes live. The same team keeps working with you on the needs that come up in use, on maintenance and on new features.',
  },
];

// Sayfaya özel şema: AboutPage düğümü, BaseLayout'un her sayfada bastığı
// Organization'ı @id ile gösterir — firma bilgisi ikinci kez yazılmaz
// (gerekçe src/utils/schema.ts'te).
const canonical = new URL(Astro.url.pathname, Astro.site);
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Us',
  url: canonical.toString(),
  inLanguage: localeTag('en'),
  mainEntity: { '@id': organizationId(Astro.site) },
};
---

<BaseLayout
  title="About"
  description="How İscotera works: scope, timeline and cost agreed in writing, accounts opened in your name and support after launch. We build our own products too."
  lang="en"
  alternate="/hakkimizda/"
  back={{ href: '/en/', label: 'Home' }}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
  </Fragment>

  {/* 1 — Hero. İç sayfalar yazıyla açılır (fotoğraflı hero ana sayfaya ait);
      üstteki kırmızı etiket, hizmet sayfalarındaki kırmızı sıra numarasının
      karşılığı. */}
  <section class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
    <div class="max-w-3xl">
      <p class="text-xs font-bold tracking-[0.14em] text-brand uppercase">
        About us
      </p>
      <h1 class="mt-3 text-3xl font-bold text-ink-strong sm:text-4xl">
        We build software that makes your business processes easier
      </h1>
      <p class="mt-5 text-lg text-ink-muted">
        İscotera is a software company. We build web applications, mobile apps
        and custom software for businesses and organisations, and alongside
        client work we publish products of our own.
      </p>
      <p class="mt-4 text-lg text-ink-muted">
        Each feeds the other: what we learn on client projects goes into our
        own products, and what we learn running our own products goes back
        into client work.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/en/contact/"
          class="inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
        >
          Get in touch
        </a>
        <a
          href="/en/services/"
          class="inline-block rounded-lg border border-line-strong px-6 py-3 text-sm font-semibold text-ink-soft transition-colors hover:border-ink-subtle"
        >
          Our services
        </a>
      </div>
    </div>
  </section>

  {/* 2 — Öngörülebilirlik: hizmet listesindeki şeritle aynı düzen (yazı +
      gerçek fotoğraf). Tek seferlik olduğu için bileşene çıkarılmadı. */}
  <section class="mx-auto max-w-5xl px-4 pb-14">
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-14">
      <div>
        <h2 class="text-2xl font-bold text-ink-strong">
          Predictable projects
        </h2>
        <p class="mt-4 leading-relaxed text-ink-muted">
          Many of the problems in software projects come from how the work is
          run. Timelines slip and costs overrun the original estimate. And once
          the project is finished, only the developer knows how the system
          works.
        </p>
        <p class="mt-4 leading-relaxed text-ink-muted">
          To reduce these risks, we start every project with a written
          framework. We document the scope, timeline and cost before
          development begins, and we share our progress with you openly
          throughout the project. We open store and server accounts in your
          name, and your data always stays yours. That keeps the process
          predictable from start to finish.
        </p>
      </div>
      <Image
        src={planningImg}
        alt="Hands working together over printed documents on a desk, pens in hand"
        width={980}
        class="h-64 w-full rounded-xl border border-line object-cover sm:h-72"
      />
    </div>
  </section>

  {/* 3 — İlkeler: soluk zeminli tam genişlik bant + kırmızı numaralar; hizmet
      detayındaki "Yaklaşımımız" bölümüyle aynı dil. */}
  <section class="border-y border-line bg-surface-muted">
    <div class="mx-auto max-w-5xl px-4 py-14">
      <h2 class="text-2xl font-bold text-ink-strong">Our working principles</h2>
      <p class="mt-3 max-w-2xl text-ink-muted">
        These principles are commitments we put in writing when we prepare a
        proposal.
      </p>
      <div class="mt-8 grid gap-8 md:grid-cols-3 md:gap-x-10 md:gap-y-10">
        {
          principles.map((item, i) => (
            <div>
              <p class="text-sm font-extrabold text-brand">{i + 1}</p>
              <h3 class="mt-1.5 font-semibold text-ink-strong">{item.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">
                {item.text}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 4 — Kendi ürünlerimiz: genç bir firmanın sayı vermeden gösterebileceği en
      somut kanıt. Sayfa sayı/yıl/proje adedi iddia etmez (bilinçli karar).
      İngilizce blogda yazı olmadığı için Türkçe sayfadaki blog bağlantısı
      burada yok — boş bir listeye göndermek kanıt olmaz. */}
  <section class="mx-auto max-w-5xl px-4 pt-14 pb-14">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold text-ink-strong">
        Our own products
      </h2>
      <p class="mt-4 leading-relaxed text-ink-muted">
        We do not just build our own products, we also keep them live and run
        them. That gives us first-hand experience of store reviews, user
        feedback and maintaining a live app. Our timeline and maintenance
        estimates draw on that experience.
      </p>
      <p class="mt-4 leading-relaxed text-ink-muted">
        If you'd like to see our work in practice, our products and case
        studies are on the Products page. This site itself is built on the
        same foundations we set up for our clients.
      </p>
      <a
        href="/en/products/"
        class="mt-5 inline-block text-sm font-semibold text-action-ink hover:underline"
      >
        Explore our products →
      </a>
    </div>
  </section>

  {/* 5 — Hizmetler: ana sayfadaki kart dizisinin aynısı, iç bağlantı için. */}
  <section class="mx-auto max-w-5xl px-4 pb-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-2xl font-bold text-ink-strong">Our services</h2>
      <a
        href="/en/services/"
        class="shrink-0 text-sm font-semibold text-action-ink hover:underline"
      >
        All services
      </a>
    </div>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={`/en/services/${service.en.slug}/`}
            class="rounded-lg border border-line p-6 transition hover:border-brand/40 hover:shadow-md"
          >
            <h3 class="font-semibold text-ink-strong">{service.en.title}</h3>
            <p class="mt-2 text-sm text-ink-muted">{service.en.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  {/* 6 — Kapanış çağrısı (site genelindeki kutunun aynısı) */}
  <section class="mx-auto max-w-5xl px-4 pb-20">
    <div
      class="rounded-2xl border border-line bg-surface-muted p-8 text-center sm:p-12"
    >
      <h2 class="text-2xl font-bold text-ink-strong">
        Let's talk about your project
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-muted">
        Tell us what you need and we'll come back to you with an assessment
        that sets out a clear timeline and budget.
      </p>
      <a
        href="/en/contact/"
        class="mt-6 inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>
