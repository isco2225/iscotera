---
import { getCollection } from 'astro:content';
import ProductPanel from '../../../components/ProductPanel.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PagePlaceholder from '../../../components/PagePlaceholder.astro';
import { useTranslations } from '../../../i18n/ui';

const t = useTranslations('en');

// Drafts are visible in dev only; hidden in production builds.
const projects = (
  await getCollection(
    'projects',
    ({ id, data }) => id.startsWith('en/') && (import.meta.env.DEV || !data.draft)
  )
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Products"
  description="Our own products at İscotera and the systems we have built for our clients."
  lang="en"
  alternate="/urunler/"
  back={{ href: '/en/', label: 'Home' }}
>
  <section class="mx-auto max-w-5xl px-4 pt-16 pb-10">
    <h1 class="text-3xl font-bold text-ink-strong">Our products</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      Our own products and the systems we have built for our clients.
    </p>
    {
      projects.length === 0 && (
        <div class="mt-8">
          <PagePlaceholder note={t('projects.empty')} />
        </div>
      )
    }
  </section>

  {/* Her ürün kendi renginde bir panel (ProductPanel). İlk panel sayfanın ilk
      ekranında durduğu için görseli ertelenmeden yüklenir. */}
  {
    projects.length > 0 && (
      <div class="mx-auto flex max-w-5xl flex-col gap-7 px-4">
        {projects.map((project, i) => (
          <ProductPanel
            project={project}
            href={`/en/products/${project.id.replace('en/', '')}/`}
            linkLabel="View the product"
            lang="en"
            as="h2"
            eager={i === 0}
          />
        ))}
      </div>
    )
  }

  <section class="mx-auto max-w-5xl px-4 py-14">
    <section class="rounded-2xl border border-line bg-surface-muted p-8 text-center sm:p-12">
      <h2 class="text-2xl font-bold text-ink-strong">Let's talk about your project</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-muted">Tell us what you have in mind. We'll look at it with you and send you the roadmap and budget in writing.</p>
      <a
        href="/en/contact/"
        class="mt-6 inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Get in touch
      </a>
    </section>
  </section>
</BaseLayout>
