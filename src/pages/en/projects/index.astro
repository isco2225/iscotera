---
import { getCollection } from 'astro:content';
import ProjectCard from '../../../components/ProjectCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PagePlaceholder from '../../../components/PagePlaceholder.astro';
import { useTranslations } from '../../../i18n/ui';

const t = useTranslations('en');

// Drafts are visible in dev only; hidden in production builds.
const projects = (
  await getCollection(
    'projects',
    ({ id, data }) => id.startsWith('en/') && (import.meta.env.DEV || !data.draft)
  )
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Products"
  description="Products built by İscotera and their case studies."
  lang="en"
  alternate="/projeler/"
  back={{ href: '/en/', label: 'Home' }}
>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-bold text-ink-strong">Our Products</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      Products we built and the results they achieved.
    </p>

    <div class="mt-8">
      {
        projects.length === 0 ? (
          <PagePlaceholder note={t('projects.empty')} />
        ) : (
          <div class="flex flex-col gap-8">
            {projects.map((project) => (
              <ProjectCard
                project={project}
                href={`/en/projects/${project.id.replace('en/', '')}/`}
                linkLabel="View case study"
                lang="en"
                as="h2"
              />
            ))}
          </div>
        )
      }
    </div>

    <section class="mt-16 rounded-2xl border border-line bg-surface-muted p-8 text-center sm:p-12">
      <h2 class="text-2xl font-bold text-ink-strong">Your product could be next</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-muted">Tell us what you have in mind and we'll map out an honest plan and a clear budget.</p>
      <a
        href="/en/contact/"
        class="mt-6 inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Talk about your project
      </a>
    </section>
  </section>
</BaseLayout>
