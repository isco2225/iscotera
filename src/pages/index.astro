---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductPanel from '../components/ProductPanel.astro';
import { services } from '../data/services';
import { BLOG_HOME_SIZES, blogThumbOptions } from '../utils/blog';
import teamImg from '../assets/home/team.jpg';
import roomImg from '../assets/home/meeting-room.jpg';

// Ana sayfada en fazla iki ürün ve iki yazı gösterilir; gerisi kendi
// listelerinde. Taslaklar yalnızca geliştirme ortamında görünür.
const products = (
  await getCollection(
    'projects',
    ({ id, data }) => id.startsWith('tr/') && (import.meta.env.DEV || !data.draft)
  )
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const posts = (
  await getCollection(
    'blog',
    ({ id, data }) => id.startsWith('tr/') && (import.meta.env.DEV || !data.draft)
  )
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// Süreç adımları. NOT: Metindeki taahhütler (yazılı süre ve maliyet, bakım
// desteği) gerçekten tutulabilecek sözler olmalı. Belirli aralıklarla sürüm
// gösterme sözü verilmez; böyle bir uygulama yok (2026-09-23).
const steps = [
  {
    title: 'Keşif',
    thesis: 'Önce ne yapılmaması gerektiğini konuşuruz.',
    text: 'İhtiyacınızı, elinizdeki sistemi ve bütçenizi birlikte gözden geçiririz. Yazılım geliştirmek doğru cevap değilse bunu da açıkça söyleriz.',
  },
  {
    title: 'Planlama',
    thesis: 'Süre ve maliyet, geliştirme başlamadan yazılı olarak belirlenir.',
    text: 'Kapsamı maddelere ayırır, her maddenin süresini ve fiyatını netleştiririz. Onayladığınız belge işin sonuna kadar ortak referansımız olur.',
  },
  {
    title: 'Geliştirme',
    thesis: 'İlerlemeye siz de şahit olursunuz.',
    text: 'Bu aşamada ilerlemeyi sizinle paylaşır, geri bildirimlerinizi sürece dahil ederiz. Değişikliklerin erken yapılması hem maliyeti hem de riski azaltır.',
  },
  {
    title: 'Yayın ve sonrası',
    thesis: 'Teslimden sonra da sorumluluğumuz sürer.',
    text: 'Ürünü yayına alır, ekibinize devrederiz. Sonrasında bakım ve yeni özellikler için yanınızda kalmaya devam ederiz.',
  },
];
---

<BaseLayout
  title="İscotera — Yazılım Çözümleri"
  description="Web, mobil ve özel yazılım geliştiren bir yazılım firması. Kapsam, süre ve maliyet baştan yazılı olarak netleşir; ilerlemeyi siz de takip edebilirsiniz."
  lang="tr"
  alternate="/en/"
>
  {/* Hero. Arka plandaki üç katman (nokta dokusu, spot, grain) yalnızca
      süs: kurallar global.css'te (.hero-*), tuvalde seçilen "Yön H". */}
  <section class="relative overflow-hidden">
    <div class="hero-dots absolute inset-0" aria-hidden="true"></div>
    <div
      class="hero-spot absolute -top-20 left-1/2 h-[560px] w-full max-w-[700px] -translate-x-1/2"
      aria-hidden="true"
    >
    </div>
    <div class="hero-grain absolute inset-0" aria-hidden="true"></div>
    <div
      class="relative mx-auto grid max-w-5xl items-center gap-10 px-4 py-16 md:grid-cols-2 md:gap-14 md:py-20"
    >
      <div>
        <h1 class="text-4xl font-bold tracking-tight text-ink-strong sm:text-5xl">
          Web, mobil ve özel yazılım geliştiriyoruz
        </h1>
        <p class="mt-4 max-w-xl text-lg text-ink-muted">
          Kapsamı, süreyi ve maliyeti işe başlamadan önce yazılı olarak
          netleştiriyoruz. Proje boyunca ilerlemeyi yakından takip
          edebilirsiniz.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/iletisim/"
            class="rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
          >
            Bize Ulaşın
          </a>
          <a
            href="/urunler/"
            class="rounded-lg border border-line-strong px-6 py-3 text-sm font-semibold text-ink-soft transition-colors hover:border-ink-subtle"
          >
            Ürünlerimiz
          </a>
        </div>
      </div>
      {/* Sağdaki kart: hero görseli, yani LCP adayı — lazy bırakılmaz. 2x ekran
          için genişlik, kartın en geniş hâlinin (~480px) iki katı. */}
      <Image
        src={roomImg}
        alt="Cam bölmeli modern bir toplantı odası: koyu masada açık bir dizüstü bilgisayar, duvarda ekran"
        width={960}
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/3] w-full rounded-2xl border border-line object-cover shadow-xl md:justify-self-end md:max-w-[480px]"
      />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-2xl font-bold text-ink-strong">Biz kimiz?</h2>
    <div class="mt-4 max-w-3xl space-y-4">
      <p class="text-lg text-ink-soft">
        İscotera, müşterileri için web ve mobil yazılım geliştiriyor. Yazılımı
        bir amaç olarak değil, işinizi kolaylaştıran bir araç olarak görüyoruz.
      </p>
      <p class="text-ink-muted">
        Teknoloji seçimlerini projenin ihtiyacına göre belirliyoruz. Her işe
        aynı çözümü uygulamak yerine bütçenize ve işin büyüklüğüne uyan yolu
        öneriyoruz. Kendi ürünlerimizi de geliştirip yayınladığımız için bir
        projenin yayına alındıktan sonra neler getirdiğini de biliyoruz.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-2xl font-bold text-ink-strong">Hizmetlerimiz</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={`/hizmetler/${service.tr.slug}/`}
            class="rounded-lg border border-line p-6 transition hover:border-brand/40 hover:shadow-md"
          >
            <h3 class="font-semibold text-ink-strong">{service.tr.title}</h3>
            <p class="mt-2 text-sm text-ink-muted">{service.tr.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  {
    products.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 pb-16">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="text-xs font-bold tracking-[0.14em] text-brand uppercase">
              Ürünlerimiz
            </p>
            <h2 class="mt-3 text-3xl font-bold text-ink-strong">Geliştirdiğimiz ürünler</h2>
          </div>
          <a
            href="/urunler/"
            class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-line-strong px-5 text-sm font-semibold text-ink-soft transition-colors hover:border-ink-subtle hover:text-ink-strong"
          >
            Tüm ürünler
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
        </div>
        <div class="mt-9 flex flex-col gap-7">
          {products.map((product) => (
            <ProductPanel
              project={product}
              href={`/urunler/${product.id.replace('tr/', '')}/`}
              linkLabel="Ürünü incele"
              lang="tr"
            />
          ))}
        </div>
      </section>
    )
  }

  {/* Süreç bölümü: solda sabit kalan tanıtım sütunu (etiket + başlık + çağrı +
      ekip fotoğrafı), sağda kırmızı numaralı dikey çizelge. Düzen ilhamı
      kullanıcının beğendiği bir ajans sitesinden (2026-08-29); renkler,
      yazı ve içerik tamamen bizim. */}
  <section class="mx-auto max-w-5xl px-4 pb-20">
    <div class="grid gap-12 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div class="md:sticky md:top-24 md:self-start">
        <p class="text-xs font-bold tracking-[0.14em] text-ink-subtle uppercase">
          Çalışma sürecimiz
        </p>
        <h2 class="mt-3 text-4xl font-bold text-ink-strong sm:text-5xl sm:leading-[1.15]">
          Her aşamada ne olacağını baştan bilirsiniz
        </h2>
        <p class="mt-5 text-lg text-ink-muted">
          Neyi birlikte karara bağlayacağımız ve her adımın hangi çıktıyla
          biteceği, işin en başında yazılı olur.
        </p>
        <a
          href="/iletisim/"
          class="mt-6 inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
        >
          Bize Ulaşın
        </a>
        <Image
          src={teamImg}
          alt="Dizüstü bilgisayarların başında birlikte çalışan üç kişilik ekip"
          width={980}
          class="mt-8 h-64 w-full rounded-xl border border-line object-cover sm:h-80"
        />
      </div>
      <ol class="relative">
        {/* Gri kılavuz çizgi + kaydırdıkça dolan kırmızı ilerleme (process-fill,
            global.css). Desteklemeyen tarayıcıda yalnızca gri çizgi kalır. */}
        <div
          class="absolute top-2 bottom-2 left-[7px] w-px bg-line"
          aria-hidden="true"
        >
          <div class="process-fill h-full w-full bg-brand"></div>
        </div>
        {
          steps.map((step, i) => (
            <li class="relative pb-16 pl-10 last:pb-0 sm:pl-14 md:pb-24">
              <span
                class="absolute top-2 left-0 flex h-[15px] w-[15px] items-center justify-center rounded-full border border-line-strong bg-surface"
                aria-hidden="true"
              >
                <span class="h-[5px] w-[5px] rounded-full bg-ink-subtle" />
              </span>
              <div class="flex items-start gap-5">
                {/* Görsel numara dekoratif; sıralamayı zaten <ol> veriyor */}
                <span
                  class="text-6xl leading-none font-extrabold text-brand md:text-7xl"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <div class="pt-1.5">
                  <h3 class="text-2xl font-bold text-ink-strong">{step.title}</h3>
                  <p class="mt-2.5 text-lg font-medium text-ink">{step.thesis}</p>
                  <p class="mt-2 text-lg leading-relaxed text-ink-muted">
                    {step.text}
                  </p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 pb-16">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-2xl font-bold text-ink-strong">Son yazılar</h2>
          <a
            href="/blog/"
            class="shrink-0 text-sm font-semibold text-action-ink hover:underline"
          >
            Tüm yazılar
          </a>
        </div>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id.replace('tr/', '')}/`}
              class="group rounded-lg border border-line p-6 transition hover:border-brand/40 hover:shadow-md"
            >
              {post.data.cover && (
                <Image
                  src={post.data.cover}
                  alt=""
                  {...blogThumbOptions}
                  sizes={BLOG_HOME_SIZES}
                  class="mb-4 aspect-[21/9] w-full rounded-lg object-cover"
                />
              )}
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-sm text-ink-subtle"
              >
                {post.data.pubDate.toLocaleDateString('tr-TR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <h3 class="mt-2 font-semibold text-ink-strong transition-colors group-hover:text-action-ink">
                {post.data.title}
              </h3>
              <p class="mt-2 text-sm text-ink-muted">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-4 pb-20">
    <div
      class="rounded-2xl border border-line bg-surface-muted p-8 text-center sm:p-12"
    >
      <h2 class="text-2xl font-bold text-ink-strong">Bir fikriniz mi var?</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-muted">
        Ne yapmak istediğinizi anlatın; size dürüst bir değerlendirme, net bir
        süre ve bütçe çıkaralım.
      </p>
      <a
        href="/iletisim/"
        class="mt-6 inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Bize ulaşın
      </a>
    </div>
  </section>
</BaseLayout>
