---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { services } from '../data/services';

// Ana sayfada en fazla iki ürün ve iki yazı gösterilir; gerisi kendi
// listelerinde. Taslaklar yalnızca geliştirme ortamında görünür.
const products = (
  await getCollection(
    'projects',
    ({ id, data }) => id.startsWith('tr/') && (import.meta.env.DEV || !data.draft)
  )
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const posts = (
  await getCollection(
    'blog',
    ({ id, data }) => id.startsWith('tr/') && (import.meta.env.DEV || !data.draft)
  )
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// TODO: Süreç adımlarının metinleri taslak — gerçek çalışma biçimine göre gözden geçirilecek.
const steps = [
  {
    title: 'Konuşalım',
    text: 'İhtiyacınızı ve bütçenizi netleştiririz. Yazılım gerekmiyorsa bunu da söyleriz.',
  },
  {
    title: 'Planlayalım',
    text: 'Kapsamı, süreyi ve maliyeti yazılı olarak paylaşırız; yolda sürpriz çıkmaz.',
  },
  {
    title: 'Geliştirelim',
    text: 'Düzenli aralıklarla çalışan sürüm gösteririz, yönü birlikte ayarlarız.',
  },
  {
    title: 'Yayına alalım',
    text: 'Ürünü teslim ederiz ve sonrasında bakımıyla yanınızda kalırız.',
  },
];
---

<BaseLayout
  title="İscotera — Yazılım Çözümleri"
  description="İscotera; web, mobil ve işletmelere özel yazılım çözümleri geliştiren bir yazılım firmasıdır."
  lang="tr"
  alternate="/en/"
>
  <section class="mx-auto max-w-5xl px-4 py-20 text-center">
    <h1 class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
      Fikirden ürüne, yazılım çözümleri
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600">
      Web, mobil ve işletmenize özel yazılım projelerinizi uçtan uca geliştiriyoruz.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a
        href="/iletisim/"
        class="rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Bize Ulaşın
      </a>
      <a
        href="/projeler/"
        class="rounded-lg border border-neutral-300 px-6 py-3 text-sm font-semibold text-neutral-700 transition-colors hover:border-neutral-500"
      >
        Ürünlerimiz
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-2xl font-bold text-neutral-900">Hizmetlerimiz</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={`/hizmetler/${service.tr.slug}/`}
            class="rounded-lg border border-neutral-200 p-6 transition hover:border-brand/40 hover:shadow-md"
          >
            <h3 class="font-semibold text-neutral-900">{service.tr.title}</h3>
            <p class="mt-2 text-sm text-neutral-600">{service.tr.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  {
    products.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 pb-16">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-2xl font-bold text-neutral-900">Ürünlerimiz</h2>
          <a
            href="/projeler/"
            class="shrink-0 text-sm font-semibold text-action hover:underline"
          >
            Tümünü gör
          </a>
        </div>
        <div class="mt-6 flex flex-col gap-8">
          {products.map((product) => (
            <ProjectCard
              project={product}
              href={`/projeler/${product.id.replace('tr/', '')}/`}
              linkLabel="İncele"
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-2xl font-bold text-neutral-900">Nasıl çalışıyoruz?</h2>
    <p class="mt-3 max-w-2xl text-neutral-600">
      Süreci baştan sona açık tutuyoruz; hangi aşamada ne olacağını bilerek
      ilerliyorsunuz.
    </p>
    <ol class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        steps.map((step, i) => (
          <li class="rounded-lg border border-neutral-200 p-6">
            <span class="text-sm font-bold text-brand">0{i + 1}</span>
            <h3 class="mt-2 font-semibold text-neutral-900">{step.title}</h3>
            <p class="mt-2 text-sm text-neutral-600">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    posts.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 pb-16">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-2xl font-bold text-neutral-900">Son yazılar</h2>
          <a
            href="/blog/"
            class="shrink-0 text-sm font-semibold text-action hover:underline"
          >
            Tüm yazılar
          </a>
        </div>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id.replace('tr/', '')}/`}
              class="group rounded-lg border border-neutral-200 p-6 transition hover:border-brand/40 hover:shadow-md"
            >
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-sm text-neutral-500"
              >
                {post.data.pubDate.toLocaleDateString('tr-TR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <h3 class="mt-2 font-semibold text-neutral-900 transition-colors group-hover:text-brand">
                {post.data.title}
              </h3>
              <p class="mt-2 text-sm text-neutral-600">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-4 pb-20">
    <div
      class="rounded-2xl border border-neutral-200 bg-neutral-50 p-8 text-center sm:p-12"
    >
      <h2 class="text-2xl font-bold text-neutral-900">Bir fikriniz mi var?</h2>
      <p class="mx-auto mt-3 max-w-xl text-neutral-600">
        Ne yapmak istediğinizi anlatın; size dürüst bir değerlendirme, net bir
        süre ve bütçe çıkaralım.
      </p>
      <a
        href="/iletisim/"
        class="mt-6 inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Bize ulaşın
      </a>
    </div>
  </section>
</BaseLayout>
