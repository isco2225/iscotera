---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';
---

<BaseLayout
  title="Hizmetler"
  description="İscotera'nın sunduğu yazılım hizmetleri: web uygulama, mobil uygulama, özel yazılım ve danışmanlık."
  lang="tr"
  alternate="/en/services/"
>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-bold text-slate-900">Hizmetlerimiz</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      İhtiyacınıza göre uçtan uca yazılım hizmetleri sunuyoruz.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        services.map((service) => (
          <a
            href={`/hizmetler/${service.tr.slug}/`}
            class="rounded-lg border border-slate-200 p-6 transition-shadow hover:shadow-md"
          >
            <h2 class="font-semibold text-slate-900">{service.tr.title}</h2>
            <p class="mt-2 text-sm text-slate-600">{service.tr.summary}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
