---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PagePlaceholder from '../../components/PagePlaceholder.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.tr.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout
  title={service.tr.title}
  description={service.tr.summary}
  lang="tr"
  alternate={`/en/services/${service.en.slug}/`}
>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-neutral-900">{service.tr.title}</h1>
    <p class="mt-3 text-lg text-neutral-600">{service.tr.summary}</p>
    <div class="mt-8 space-y-6">
      <PagePlaceholder note="Hizmetin detaylı anlatımı: kapsam, süreç, kullanılan teknolojiler..." />
      <PagePlaceholder note="Bu hizmetle ilgili örnek projeler / referanslar" />
      <PagePlaceholder note="Sık sorulan sorular (SEO için değerli bölüm)" />
    </div>
    <div class="mt-10">
      <a
        href="/iletisim/"
        class="inline-block rounded-lg bg-brand px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark"
      >
        Projenizi Konuşalım
      </a>
    </div>
  </section>
</BaseLayout>
