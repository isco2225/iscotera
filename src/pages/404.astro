---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sayfa Bulunamadı"
  description="Aradığınız sayfa bulunamadı."
  lang="tr"
>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="text-6xl font-bold text-neutral-300">404</p>
    <h1 class="mt-4 text-2xl font-bold text-neutral-900">
      Sayfa bulunamadı <span class="text-neutral-400">/ Page not found</span>
    </h1>
    <p class="mt-3 text-neutral-600">
      Aradığınız sayfa taşınmış veya hiç var olmamış olabilir.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a
        href="/"
        class="rounded-lg bg-brand px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark"
      >
        Ana Sayfa
      </a>
      <a
        href="/en/"
        class="rounded-lg border border-neutral-300 px-6 py-3 text-sm font-semibold text-neutral-700 transition-colors hover:border-neutral-500"
      >
        Home (EN)
      </a>
    </div>
  </section>
</BaseLayout>
