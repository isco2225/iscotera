---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sayfa Bulunamadı"
  description="Aradığınız sayfa bulunamadı."
  lang="tr"
>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="text-6xl font-bold text-line-strong">404</p>
    <h1 class="mt-4 text-2xl font-bold text-ink-strong">
      Sayfa bulunamadı <span class="text-ink-faint">/ Page not found</span>
    </h1>
    <p class="mt-3 text-ink-muted">
      Aradığınız sayfa taşınmış veya hiç var olmamış olabilir.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a
        href="/"
        class="rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Ana Sayfa
      </a>
      <a
        href="/en/"
        class="rounded-lg border border-line-strong px-6 py-3 text-sm font-semibold text-ink-soft transition-colors hover:border-ink-subtle"
      >
        Home (EN)
      </a>
    </div>
  </section>
</BaseLayout>
