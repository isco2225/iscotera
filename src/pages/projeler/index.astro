---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PagePlaceholder from '../../components/PagePlaceholder.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('tr');

// Taslaklar sadece geliştirme ortamında görünür; yayında gizlenir.
const projects = (
  await getCollection(
    'projects',
    ({ id, data }) => id.startsWith('tr/') && (import.meta.env.DEV || !data.draft)
  )
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projeler"
  description="İscotera'nın tamamladığı projeler ve vaka çalışmaları."
  lang="tr"
  alternate="/en/projects/"
  back={{ href: '/', label: 'Ana Sayfa' }}
>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-bold text-neutral-900">Projelerimiz</h1>
    <p class="mt-3 max-w-2xl text-neutral-600">
      Tamamladığımız projeler ve elde edilen sonuçlar.
    </p>

    <div class="mt-8">
      {
        projects.length === 0 ? (
          <PagePlaceholder note={t('projects.empty')} />
        ) : (
          <div class="grid gap-6 sm:grid-cols-2">
            {projects.map((project) => (
              <a
                href={`/projeler/${project.id.replace('tr/', '')}/`}
                class="rounded-lg border border-neutral-200 p-6 transition hover:border-brand/40 hover:shadow-md"
              >
                <h2 class="font-semibold text-neutral-900">{project.data.title}</h2>
                <p class="mt-2 text-sm text-neutral-600">{project.data.description}</p>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
