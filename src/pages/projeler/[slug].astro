---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection(
    'projects',
    ({ id, data }) => id.startsWith('tr/') && (import.meta.env.DEV || !data.draft)
  );
  return projects.map((project) => ({
    params: { slug: project.id.replace('tr/', '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  lang="tr"
  ogType="article"
  back={{ href: '/projeler/', label: 'Projeler' }}
>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-neutral-900">{project.data.title}</h1>
    <p class="mt-3 text-lg text-neutral-600">{project.data.description}</p>
    {
      (project.data.client || project.data.year) && (
        <p class="mt-2 text-sm text-neutral-500">
          {[project.data.client, project.data.year].filter(Boolean).join(' · ')}
        </p>
      )
    }
    <div class="prose prose-neutral mt-8 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
