---
import { getCollection } from 'astro:content';
import ProductPanel from '../../components/ProductPanel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PagePlaceholder from '../../components/PagePlaceholder.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('tr');

// Taslaklar sadece geliştirme ortamında görünür; yayında gizlenir.
const projects = (
  await getCollection(
    'projects',
    ({ id, data }) => id.startsWith('tr/') && (import.meta.env.DEV || !data.draft)
  )
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Ürünler"
  description="İscotera'da geliştirdiğimiz kendi ürünlerimiz ve müşterilerimiz için yaptığımız projeler."
  lang="tr"
  alternate="/en/products/"
  back={{ href: '/', label: 'Ana Sayfa' }}
>
  <section class="mx-auto max-w-5xl px-4 pt-16 pb-10">
    <h1 class="text-3xl font-bold text-ink-strong">Ürünlerimiz</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      Kendi ürünlerimiz ve müşterilerimiz için geliştirdiğimiz sistemler.
    </p>
    {
      projects.length === 0 && (
        <div class="mt-8">
          <PagePlaceholder note={t('projects.empty')} />
        </div>
      )
    }
  </section>

  {/* Her ürün kendi renginde bir panel (ProductPanel). İlk panel sayfanın ilk
      ekranında durduğu için görseli ertelenmeden yüklenir. */}
  {
    projects.length > 0 && (
      <div class="mx-auto flex max-w-5xl flex-col gap-7 px-4">
        {projects.map((project, i) => (
          <ProductPanel
            project={project}
            href={`/urunler/${project.id.replace('tr/', '')}/`}
            linkLabel="Ürünü inceleyin"
            lang="tr"
            as="h2"
            eager={i === 0}
          />
        ))}
      </div>
    )
  }

  <section class="mx-auto max-w-5xl px-4 py-14">
    <section class="rounded-2xl border border-line bg-surface-muted p-8 text-center sm:p-12">
      <h2 class="text-2xl font-bold text-ink-strong">Projenizi konuşalım</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-muted">Ne yapmak istediğinizi anlatın, birlikte değerlendirelim ve yol haritasını bütçesiyle birlikte size yazılı olarak gönderelim.</p>
      <a
        href="/iletisim/"
        class="mt-6 inline-block rounded-lg bg-action px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-action-dark"
      >
        Bize ulaşın
      </a>
    </section>
  </section>
</BaseLayout>
