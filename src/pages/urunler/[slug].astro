---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import SocialLinks from '../../components/SocialLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const all = await getCollection(
    'projects',
    ({ data }) => import.meta.env.DEV || !data.draft
  );

  // Aynı slug diğer dilde de varsa iki sayfa hreflang ile eşleştirilir.
  const translated = new Set(
    all.filter(({ id }) => id.startsWith('en/')).map(({ id }) => id.replace('en/', ''))
  );

  return all
    .filter(({ id }) => id.startsWith('tr/'))
    .map((project) => {
      const slug = project.id.replace('tr/', '');
      return {
        params: { slug },
        props: {
          project,
          alternate: translated.has(slug) ? `/en/products/${slug}/` : undefined,
        },
      };
    });
}

const { project, alternate } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  lang="tr"
  alternate={alternate}
  ogType="article"
  back={{ href: '/urunler/', label: 'Ürünler' }}
>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <div class="flex items-center gap-4">
      {
        project.data.logo && (
          <Image
            src={project.data.logo}
            alt={`${project.data.title} uygulama simgesi`}
            width={128}
            class="h-16 w-16 shrink-0 rounded-2xl border border-line"
          />
        )
      }
      <h1 class="text-3xl font-bold text-ink-strong">{project.data.title}</h1>
    </div>
    <p class="mt-4 text-lg text-ink-muted">{project.data.description}</p>
    {
      (project.data.client || project.data.year) && (
        <p class="mt-2 text-sm text-ink-subtle">
          {[project.data.client, project.data.year].filter(Boolean).join(' · ')}
        </p>
      )
    }

    {
      project.data.social.length > 0 && (
        <SocialLinks
          links={project.data.social}
          name={project.data.title}
          class="mt-2 -ml-2.5"
        />
      )
    }
    {
      project.data.links.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-3">
          {project.data.links.map((link, i) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              class:list={[
                'rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors',
                i === 0
                  ? 'bg-action text-white hover:bg-action-dark'
                  : 'border border-line-strong text-ink-soft hover:border-ink-subtle',
              ]}
            >
              {link.label}
            </a>
          ))}
        </div>
      )
    }

    {
      project.data.results.length > 0 && (
        <dl class="mt-10 grid gap-6 border-y border-line py-8 sm:grid-cols-3">
          {project.data.results.map((result) => (
            <div>
              <dt class="text-2xl font-bold text-ink-strong">{result.value}</dt>
              <dd class="mt-1 text-sm text-ink-muted">{result.label}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      project.data.screenshots.length > 0 && (
        <section class="mt-10" aria-label="Ekran görüntüleri">
          <ul class="grid grid-cols-3 gap-3 sm:gap-5">
            {project.data.screenshots.map((shot) => (
              <li>
                <Image
                  src={shot.src}
                  alt={shot.alt}
                  width={480}
                  class="w-full rounded-xl border border-line"
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="prose prose-neutral mt-8 max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
</BaseLayout>
