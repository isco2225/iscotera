---
// Ürün detay sayfası (TR). Bölümlerin tamamı ProductPage.astro içinde;
// burası yalnızca hangi ürünün hangi adreste yayınlanacağını belirliyor.
import { getCollection } from 'astro:content';
import ProductPage from '../../components/ProductPage.astro';

export async function getStaticPaths() {
  const all = await getCollection(
    'projects',
    ({ data }) => import.meta.env.DEV || !data.draft
  );

  // Aynı slug diğer dilde de varsa iki sayfa hreflang ile eşleştirilir.
  const translated = new Set(
    all.filter(({ id }) => id.startsWith('en/')).map(({ id }) => id.replace('en/', ''))
  );

  return all
    .filter(({ id }) => id.startsWith('tr/'))
    .map((project) => {
      const slug = project.id.replace('tr/', '');
      return {
        params: { slug },
        props: {
          project,
          alternate: translated.has(slug) ? `/en/products/${slug}/` : undefined,
        },
      };
    });
}

const { project, alternate } = Astro.props;
---

<ProductPage project={project} lang="tr" alternate={alternate} />
